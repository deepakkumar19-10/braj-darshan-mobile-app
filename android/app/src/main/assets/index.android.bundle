__d(function(a,e,t,i,n,o,l){n.exports=[{id:"event-1",title:"\u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u091c\u0928\u094d\u092e\u093e\u0937\u094d\u091f\u092e\u0940",titleEn:"Shri Krishna Janmashtami",location:"Mathura",locationEn:"Mathura",category:"Spiritual Festival",date:"\u092d\u093e\u0926\u094d\u0930\u092a\u0926 \u0915\u0943\u0937\u094d\u0923 \u0905\u0937\u094d\u091f\u092e\u0940 (Midnight)",month:"\u092d\u093e\u0926\u094d\u0930\u092a\u0926 (August - September)",image:"/images/events/krishna-janmashtami-mathura.png",latitude:27.5048,longitude:77.6698,desc:"\u092e\u0925\u0941\u0930\u093e \u092e\u0947\u0902 \u0936\u094d\u0930\u0940\u0915\u0943\u0937\u094d\u0923 \u091c\u0928\u094d\u092e\u092d\u0942\u092e\u093f \u092a\u0930 \u0906\u0927\u0940 \u0930\u093e\u0924 \u091c\u0928\u094d\u092e\u094b\u0924\u094d\u0938\u0935, \u092a\u0902\u091a\u093e\u092e\u0943\u0924 \u092e\u0939\u093e\u0905\u092d\u093f\u0937\u0947\u0915, \u092e\u0902\u0917\u0932\u093e \u0906\u0930\u0924\u0940 \u0914\u0930 \u0926\u093f\u0935\u094d\u092f \u0938\u0902\u0915\u0940\u0930\u094d\u0924\u0928 \u0915\u0947 \u0938\u093e\u0925 \u092d\u0935\u094d\u092f\u0924\u092e \u092a\u0930\u094d\u0935\u0964",descEn:"The supreme celebration marking the divine midnight advent of Lord Krishna with Panchamrita Mahabhisheka and darshan."},{id:"event-2",title:"\u092c\u0930\u0938\u093e\u0928\u093e \u0932\u091f\u094d\u0920\u092e\u093e\u0930 \u0939\u094b\u0932\u0940",titleEn:"Barsana Lathmar Holi",location:"Barsana & Nandgaon",locationEn:"Barsana & Nandgaon",category:"Holi Celebration",date:"\u092b\u093e\u0932\u094d\u0917\u0941\u0928 \u0936\u0941\u0915\u094d\u0932 \u0928\u0935\u092e\u0940",month:"\u092b\u093e\u0932\u094d\u0917\u0941\u0928 (February - March)",image:"/images/events/lathmar-holi-barsana.png",latitude:27.6477,longitude:77.3752,desc:"\u0928\u0902\u0926\u0917\u093e\u0902\u0935 \u0915\u0947 \u0939\u0941\u0930\u093f\u092f\u093e\u0930\u0947 \u0914\u0930 \u092c\u0930\u0938\u093e\u0928\u0947 \u0915\u0940 \u0917\u094b\u092a\u093f\u092f\u094b\u0902 \u0915\u0947 \u092e\u0927\u094d\u092f \u0916\u0947\u0932\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0935\u093f\u0936\u094d\u0935\u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0932\u091f\u094d\u0920\u092e\u093e\u0930 \u0939\u094b\u0932\u0940, \u091c\u0939\u093e\u0901 \u0922\u093e\u0932 \u0914\u0930 \u0932\u093e\u0920\u0940 \u0915\u093e \u092a\u094d\u0930\u0947\u092e\u092e\u092f \u0916\u0947\u0932 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",descEn:"World-famous playful festival where Gopis of Barsana beat the shields of cowherd men from Nandgaon with wooden batons."},{id:"event-3",title:"\u0935\u0943\u0902\u0926\u093e\u0935\u0928 \u092b\u0942\u0932\u094b\u0902 \u0915\u0940 \u0939\u094b\u0932\u0940",titleEn:"Phoolon Ki Holi (Flower Holi)",location:"Vrindavan",locationEn:"Vrindavan",category:"Holi Celebration",date:"\u092b\u093e\u0932\u094d\u0917\u0941\u0928 \u090f\u0915\u093e\u0926\u0936\u0940 (\u0930\u0902\u0917\u092d\u0930\u0940 \u090f\u0915\u093e\u0926\u0936\u0940)",month:"\u092b\u093e\u0932\u094d\u0917\u0941\u0928 (March)",image:"/images/events/phoolon-ki-holi-vrindavan.png",latitude:27.5807,longitude:77.7019,desc:"\u092c\u093e\u0902\u0915\u0947 \u092c\u093f\u0939\u093e\u0930\u0940 \u091c\u0940 \u0915\u0947 \u0906\u0902\u0917\u0928 \u092e\u0947\u0902 \u0938\u0941\u0917\u0902\u0927\u093f\u0924 \u091f\u0947\u0938\u0942, \u0917\u0941\u0932\u093e\u092c, \u0917\u0947\u0902\u0926\u093e \u0914\u0930 \u092e\u094b\u0917\u0930\u0947 \u0915\u0947 \u092b\u0942\u0932\u094b\u0902 \u0915\u0940 \u092a\u0902\u0916\u0941\u0921\u093c\u093f\u092f\u094b\u0902 \u0938\u0947 \u0916\u0947\u0932\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0905\u0932\u094c\u0915\u093f\u0915 \u0939\u094b\u0932\u0940\u0964",descEn:"A breathtaking spiritual Holi played exclusively with fresh flower petals and herbal gulal at Banke Bihari Temple."},{id:"event-4",title:"\u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092a\u0942\u091c\u093e \u090f\u0935\u0902 \u0905\u0928\u094d\u0928\u0915\u0942\u091f \u092e\u0939\u094b\u0924\u094d\u0938\u0935",titleEn:"Govardhan Puja & Annakoot",location:"Govardhan & Vrindavan",locationEn:"Govardhan & Vrindavan",category:"Spiritual Festival",date:"\u0915\u093e\u0930\u094d\u0924\u093f\u0915 \u0936\u0941\u0915\u094d\u0932 \u092a\u094d\u0930\u0924\u093f\u092a\u0926\u093e (\u0926\u0940\u092a\u093e\u0935\u0932\u0940 \u0915\u0947 \u0905\u0917\u0932\u0947 \u0926\u093f\u0928)",month:"\u0915\u093e\u0930\u094d\u0924\u093f\u0915 (October - November)",image:"/images/events/govardhan-puja.png",latitude:27.4998,longitude:77.4649,desc:"\u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092a\u0930\u094d\u0935\u0924 \u0915\u0940 \u092a\u0942\u091c\u093e \u0914\u0930 \u0920\u093e\u0915\u0941\u0930 \u091c\u0940 \u0915\u094b 56 \u092d\u094b\u0917 \u0935 \u0905\u0928\u094d\u0928\u0915\u0942\u091f \u0915\u093e \u0935\u093f\u0936\u093e\u0932 \u092a\u094d\u0930\u0938\u093e\u0926 \u0905\u0930\u094d\u092a\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0932\u093e\u0916\u094b\u0902 \u092d\u0915\u094d\u0924 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",descEn:"Celebration of Krishna lifting Govardhan Hill; colossal food mountains (Chhappan Bhog) offered to Giriraj Maharaj."},{id:"event-5",title:"\u0930\u093e\u0927\u093e\u0937\u094d\u091f\u092e\u0940 \u092e\u0939\u093e\u092e\u0939\u094b\u0924\u094d\u0938\u0935",titleEn:"Radhashtami Grand Festival",location:"Barsana",locationEn:"Barsana",category:"Spiritual Festival",date:"\u092d\u093e\u0926\u094d\u0930\u092a\u0926 \u0936\u0941\u0915\u094d\u0932 \u0905\u0937\u094d\u091f\u092e\u0940 (\u092a\u094d\u0930\u093e\u0924\u0903 04:00 AM)",month:"\u092d\u093e\u0926\u094d\u0930\u092a\u0926 (September)",image:"/images/events/radhashtami-barsana.png",latitude:27.6477,longitude:77.3752,desc:"\u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u0915\u0947 \u092a\u094d\u0930\u093e\u0915\u091f\u094d\u092f \u0926\u093f\u0935\u0938 \u092a\u0930 \u0932\u093e\u0921\u093c\u0932\u0940 \u091c\u0940 \u092e\u0902\u0926\u093f\u0930 \u092e\u0947\u0902 \u0905\u092d\u093f\u0937\u0947\u0915, \u092e\u094b\u0930 \u0915\u0941\u091f\u0940 \u092a\u0930 \u092e\u092f\u0942\u0930 \u0928\u0943\u0924\u094d\u092f \u0914\u0930 \u092c\u0930\u0938\u093e\u0928\u0947 \u0915\u0940 \u0917\u0932\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u092c\u0927\u093e\u0908 \u0917\u093e\u092f\u0928\u0964",descEn:"The divine appearance day of Shri Radha Rani celebrated atop Bhanugarh Hill with dawn Abhishekam and ecstatic Badhai singing."},{id:"event-6",title:"\u0936\u094d\u0930\u093e\u0935\u0923 \u091d\u0942\u0932\u0928 \u0909\u0924\u094d\u0938\u0935",titleEn:"Shravan Jhulan Utsav",location:"Vrindavan",locationEn:"Vrindavan",category:"Aarti & Raslila",date:"\u0936\u094d\u0930\u093e\u0935\u0923 \u0936\u0941\u0915\u094d\u0932 \u0924\u0943\u0924\u0940\u092f\u093e \u0938\u0947 \u092a\u0942\u0930\u094d\u0923\u093f\u092e\u093e",month:"\u0936\u094d\u0930\u093e\u0935\u0923 (July - August)",image:"/images/events/jhulan-utsav-vrindavan.png",latitude:27.5807,longitude:77.7019,desc:"\u0938\u093e\u0935\u0928 \u0915\u0947 \u092a\u093e\u0935\u0928 \u092e\u093e\u0939 \u092e\u0947\u0902 \u0930\u093e\u0927\u093e-\u0915\u0943\u0937\u094d\u0923 \u0915\u0947 \u0935\u093f\u0917\u094d\u0930\u0939\u094b\u0902 \u0915\u094b \u0938\u094d\u0935\u0930\u094d\u0923-\u0930\u091c\u0924 \u0915\u0947 \u092d\u0935\u094d\u092f \u091d\u0942\u0932\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u0930\u093e\u091c\u092e\u093e\u0928 \u0915\u0930 \u0918\u091f\u093e\u0913\u0902 \u0915\u0947 \u092c\u0940\u091a \u091d\u0941\u0932\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",descEn:"Deities of Radha and Krishna are placed on intricately carved gold and silver swings amidst melodious monsoon ragas."},{id:"event-7",title:"84 \u0915\u094b\u0938 \u092c\u094d\u0930\u091c \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e",titleEn:"Chaurasi Kos Braj Parikrama",location:"Entire Braj Region",locationEn:"Entire Braj Region",category:"Parikrama",date:"\u092a\u0941\u0930\u0941\u0937\u094b\u0924\u094d\u0924\u092e / \u0915\u093e\u0930\u094d\u0924\u093f\u0915 \u092e\u093e\u0938",month:"\u0935\u0930\u094d\u0937\u092d\u0930 / \u0935\u093f\u0936\u0947\u0937 \u092a\u0930\u094d\u0935",image:"/images/events/braj-parikrama.png",latitude:27.4924,longitude:77.6737,desc:"\u092c\u094d\u0930\u091c \u0915\u0947 \u0938\u092e\u0938\u094d\u0924 84 \u0915\u094b\u0938 (\u0932\u0917\u092d\u0917 250 \u0915\u093f\u092e\u0940) \u092e\u0947\u0902 \u092b\u0948\u0932\u0947 \u0935\u0928\u094b\u0902, \u0909\u092a\u0935\u0928\u094b\u0902, \u0915\u0941\u0902\u0921\u094b\u0902 \u0914\u0930 \u092a\u0930\u094d\u0935\u0924\u094b\u0902 \u0915\u0940 \u092a\u093e\u0935\u0928 \u092a\u0926\u092f\u093e\u0924\u094d\u0930\u093e\u0964",descEn:"The sacred 250-kilometer circumambulation encompassing all 12 forests, 24 sub-forests, and pilgrimage ponds of Braj."},{id:"event-8",title:"\u0917\u094b\u0915\u0941\u0932 \u0928\u0902\u0926\u094b\u0924\u094d\u0938\u0935",titleEn:"Gokul Nandotsav",location:"Gokul",locationEn:"Gokul",category:"Spiritual Festival",date:"\u092d\u093e\u0926\u094d\u0930\u092a\u0926 \u0915\u0943\u0937\u094d\u0923 \u0928\u0935\u092e\u0940",month:"\u092d\u093e\u0926\u094d\u0930\u092a\u0926 (August - September)",image:"/images/events/gopal-janmotsav-gokul.png",latitude:27.4379,longitude:77.7214,desc:"\u091c\u0928\u094d\u092e\u093e\u0937\u094d\u091f\u092e\u0940 \u0915\u0947 \u0905\u0917\u0932\u0947 \u0926\u093f\u0928 \u0928\u0902\u0926 \u092c\u093e\u092c\u093e \u0915\u0947 \u092e\u0939\u0932 \u0917\u094b\u0915\u0941\u0932 \u092e\u0947\u0902 \u0939\u0932\u094d\u0926\u0940, \u0926\u0939\u0940 \u0914\u0930 \u092e\u093e\u0916\u0928 \u0932\u0941\u091f\u093e\u0915\u0930 '\u0928\u0902\u0926 \u0915\u0947 \u0906\u0928\u0902\u0926 \u092d\u092f\u094b' \u0915\u093e \u0909\u0932\u094d\u0932\u093e\u0938 \u092e\u0928\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",descEn:"Rejoicing in Gokul following Krishna's birth; joyously showering curd, turmeric, and butter upon devotees."}]},851);
