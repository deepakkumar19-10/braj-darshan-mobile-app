__d(function(i,a,e,t,n,r,s){n.exports=[{id:1,name:"Shri Banke Bihari Ji Mandir",nameHindi:"\u0936\u094d\u0930\u0940 \u092c\u093e\u0902\u0915\u0947 \u092c\u093f\u0939\u093e\u0930\u0940 \u091c\u0940 \u092e\u0902\u0926\u093f\u0930",city:"Vrindavan",cityHindi:"\u0935\u0943\u0902\u0926\u093e\u0935\u0928",deity:"Lord Krishna (Tribhanga Posture)",deityHindi:"\u0936\u094d\u0930\u0940 \u092c\u093e\u0902\u0915\u0947 \u092c\u093f\u0939\u093e\u0930\u0940 \u0932\u093e\u0932 (\u0924\u094d\u0930\u093f\u092d\u0902\u0917 \u092e\u0941\u0926\u094d\u0930\u093e)",image:"/images/temples/banke-bihari.avif",latitude:27.5807,longitude:77.7019,featured:!0,tagline:"The Supreme Jewel of Vrindavan's Divine Bliss",taglineHindi:"\u0935\u0943\u0902\u0926\u093e\u0935\u0928 \u0927\u093e\u092e \u0915\u093e \u092a\u0930\u092e \u092a\u093e\u0935\u0928 \u0905\u0932\u094c\u0915\u093f\u0915 \u092e\u0902\u0926\u093f\u0930",shortDescription:"Swami Haridas Ji \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0915\u091f \u0935\u093f\u0917\u094d\u0930\u0939, \u091c\u0939\u093e\u0901 \u092c\u093f\u0939\u093e\u0930\u0940 \u091c\u0940 \u0915\u0947 \u0928\u092f\u0928\u094b\u0902 \u0915\u0940 \u092e\u094b\u0939\u093f\u0928\u0940 \u091b\u0935\u093f \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u0930-\u092c\u093e\u0930 \u092a\u0930\u094d\u0926\u093e (\u091d\u093e\u0902\u0915\u0940 \u0926\u0930\u094d\u0936\u0928) \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",shortDescriptionEn:"Manifested by Swami Haridas Ji, where Jhanki Darshan (frequent curtaining) is performed to behold the mesmerizing eyes of Bihari Ji.",history:"\u092f\u0939 \u092e\u0902\u0926\u093f\u0930 \u0938\u094d\u0935\u093e\u092e\u0940 \u0939\u0930\u093f\u0926\u093e\u0938 \u091c\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u0927\u093f\u0935\u0928 \u092e\u0947\u0902 \u092a\u094d\u0930\u0915\u091f \u0915\u093f\u090f \u0917\u090f \u0936\u094d\u0930\u0940 \u092c\u093e\u0902\u0915\u0947 \u092c\u093f\u0939\u093e\u0930\u0940 \u091c\u0940 \u0915\u0947 \u0935\u093f\u0917\u094d\u0930\u0939 \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0939\u0948\u0964 1864 \u092e\u0947\u0902 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092d\u0935\u094d\u092f \u092e\u0902\u0926\u093f\u0930 \u0915\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0917\u094b\u0938\u094d\u0935\u093e\u092e\u0940 \u092c\u0902\u0927\u0941\u0913\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u0930\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u092f\u0939\u093e\u0901 \u0915\u094b\u0908 \u0918\u0902\u091f\u0940 \u092f\u093e \u0936\u0902\u0916 \u0928\u0939\u0940\u0902 \u092c\u091c\u093e\u092f\u093e \u091c\u093e\u0924\u093e, \u0915\u0947\u0935\u0932 \u092e\u0927\u0941\u0930 \u0928\u093e\u092e \u0938\u0902\u0915\u0940\u0930\u094d\u0924\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",architecture:"\u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928\u0940 \u0939\u0935\u0947\u0932\u0940 \u0938\u094d\u0925\u093e\u092a\u0924\u094d\u092f \u0915\u0932\u093e, \u091c\u093f\u0938\u092e\u0947\u0902 \u0938\u0902\u0917\u092e\u0930\u092e\u0930 \u0914\u0930 \u092e\u0947\u0939\u0930\u093e\u092c\u0926\u093e\u0930 \u091d\u0930\u094b\u0916\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0939\u0941\u0906 \u0939\u0948\u0964",timings:{summer:"\u092a\u094d\u0930\u093e\u0924\u0903 07:45 \u0938\u0947 12:00, \u0938\u093e\u092f\u0902 05:30 \u0938\u0947 \u0930\u093e\u0924\u094d\u0930\u093f 09:30",winter:"\u092a\u094d\u0930\u093e\u0924\u0903 08:45 \u0938\u0947 \u0926\u094b\u092a\u0939\u0930 01:00, \u0938\u093e\u092f\u0902 04:30 \u0938\u0947 \u0930\u093e\u0924\u094d\u0930\u093f 08:30",aarti:"\u0936\u094d\u0930\u0943\u0902\u0917\u093e\u0930 \u0906\u0930\u0924\u0940: 08:00 AM, \u0936\u092f\u0928 \u0906\u0930\u0924\u0940: 09:15 PM (\u092c\u093f\u0939\u093e\u0930\u0940 \u091c\u0940 \u092e\u0947\u0902 \u092e\u0902\u0917\u0932\u093e \u0906\u0930\u0924\u0940 \u0915\u0947\u0935\u0932 \u091c\u0928\u094d\u092e\u093e\u0937\u094d\u091f\u092e\u0940 \u0915\u094b \u0939\u094b\u0924\u0940 \u0939\u0948)"},location:"\u0917\u094b\u0926\u094c\u0932\u093f\u092f\u093e \u0930\u094b\u0921, \u092c\u093e\u0902\u0915\u0947 \u092c\u093f\u0939\u093e\u0930\u0940 \u0915\u0949\u0932\u094b\u0928\u0940, \u0935\u0943\u0902\u0926\u093e\u0935\u0928",festivals:["\u091d\u0942\u0932\u0928 \u0909\u0924\u094d\u0938\u0935 (\u0938\u093e\u0935\u0928)","\u091c\u0928\u094d\u092e\u093e\u0937\u094d\u091f\u092e\u0940 (\u092e\u0902\u0917\u0932\u093e \u0906\u0930\u0924\u0940)","\u0939\u094b\u0932\u0940 \u0930\u0902\u0917\u092d\u0930\u0940 \u090f\u0915\u093e\u0926\u0936\u0940","\u0936\u0930\u0926 \u092a\u0942\u0930\u094d\u0923\u093f\u092e\u093e"],darshanTips:"\u092d\u0940\u0921\u093c \u0938\u0947 \u092c\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u094b\u092a\u0939\u0930 11:30 \u092c\u091c\u0947 \u092f\u093e \u0938\u093e\u092f\u0902 4:30 \u092c\u091c\u0947 \u092a\u0939\u0941\u0902\u091a\u0947\u0902\u0964 \u092e\u094b\u092c\u093e\u0907\u0932 \u0935 \u0915\u0940\u092e\u0924\u0940 \u0938\u093e\u092e\u093e\u0928 \u091c\u0947\u092c\u0915\u0924\u0930\u0947 \u090f\u0935\u0902 \u092c\u0902\u0926\u0930\u094b\u0902 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0947\u0902\u0964"},{id:2,name:"Shri Krishna Janmabhoomi",nameHindi:"\u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u091c\u0928\u094d\u092e\u0938\u094d\u0925\u093e\u0928",city:"Mathura",cityHindi:"\u092e\u0925\u0941\u0930\u093e",deity:"Lord Krishna & Mata Devaki-Vasudeva",deityHindi:"\u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u090f\u0935\u0902 \u0926\u0947\u0935\u0915\u0940-\u0935\u0938\u0941\u0926\u0947\u0935",image:"/images/temples/krishna-janmabhoomi.avif",latitude:27.5048,longitude:77.6698,featured:!0,tagline:"The Holy Prison Cell Where the Supreme Lord Appeared",taglineHindi:"\u0915\u0902\u0938 \u0915\u093e \u092a\u093e\u0935\u0928 \u0915\u093e\u0930\u093e\u0917\u093e\u0930 \u091c\u0939\u093e\u0901 \u092d\u0917\u0935\u093e\u0928 \u0915\u093e \u092a\u094d\u0930\u093e\u0915\u091f\u094d\u092f \u0939\u0941\u0906",shortDescription:"\u0915\u0902\u0938 \u0915\u0947 \u0915\u093e\u0930\u093e\u0917\u093e\u0930 \u0915\u093e \u0935\u0939 \u092a\u0935\u093f\u0924\u094d\u0930 \u0917\u0930\u094d\u092d\u0917\u0943\u0939 \u091c\u0939\u093e\u0901 \u0926\u094d\u0935\u093e\u092a\u0930 \u092f\u0941\u0917 \u092e\u0947\u0902 \u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0915\u093e \u0905\u0935\u0924\u0930\u0923 \u0939\u0941\u0906 \u0925\u093e\u0964",shortDescriptionEn:"The sacred sanctum of Kamsa's ancient prison cell where Lord Krishna incarnated in Dvapara Yuga.",history:"\u0926\u094d\u0935\u093e\u092a\u0930 \u092f\u0941\u0917 \u092e\u0947\u0902 \u0915\u0902\u0938 \u0915\u0947 \u0915\u093e\u0930\u093e\u0917\u093e\u0930 \u0915\u093e \u092e\u0942\u0932 \u0938\u094d\u0925\u093e\u0928\u0964 \u0938\u0930\u094d\u0935\u092a\u094d\u0930\u0925\u092e \u092d\u0917\u0935\u093e\u0928 \u0915\u0943\u0937\u094d\u0923 \u0915\u0947 \u092a\u094d\u0930\u092a\u094c\u0924\u094d\u0930 \u0935\u091c\u094d\u0930\u0928\u093e\u092d \u0926\u094d\u0935\u093e\u0930\u093e \u092e\u0902\u0926\u093f\u0930 \u0915\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0930\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092d\u0935\u094d\u092f \u092e\u0902\u0926\u093f\u0930 \u092a\u0930\u093f\u0938\u0930 \u092e\u0947\u0902 \u092d\u093e\u0917\u0935\u0924 \u092d\u0935\u0928, \u0915\u0947\u0936\u0935 \u0926\u0947\u0935 \u092e\u0902\u0926\u093f\u0930 \u0914\u0930 \u092a\u0935\u093f\u0924\u094d\u0930 \u092a\u094b\u0924\u0930\u093e \u0915\u0941\u0902\u0921 \u0938\u094d\u0925\u093f\u0924 \u0939\u0948\u0902\u0964",architecture:"\u092d\u0935\u094d\u092f \u0928\u093e\u0917\u0930 \u0936\u0948\u0932\u0940 \u090f\u0935\u0902 \u0938\u0902\u0917\u092e\u0930\u092e\u0930 \u0928\u0915\u094d\u0915\u093e\u0936\u0940, \u0926\u0940\u0935\u093e\u0930\u094b\u0902 \u092a\u0930 \u0938\u092e\u094d\u092a\u0942\u0930\u094d\u0923 \u0936\u094d\u0930\u0940\u092e\u0926\u094d\u092d\u093e\u0917\u0935\u0924 \u092e\u0939\u093e\u092a\u0941\u0930\u093e\u0923 \u0915\u0947 \u0936\u094d\u0932\u094b\u0915 \u0905\u0902\u0915\u093f\u0924 \u0939\u0948\u0902\u0964",timings:{summer:"\u092a\u094d\u0930\u093e\u0924\u0903 05:00 \u0938\u0947 \u0926\u094b\u092a\u0939\u0930 12:00, \u0938\u093e\u092f\u0902 04:00 \u0938\u0947 \u0930\u093e\u0924\u094d\u0930\u093f 09:30",winter:"\u092a\u094d\u0930\u093e\u0924\u0903 05:30 \u0938\u0947 \u0926\u094b\u092a\u0939\u0930 12:00, \u0938\u093e\u092f\u0902 03:30 \u0938\u0947 \u0930\u093e\u0924\u094d\u0930\u093f 09:00",aarti:"\u092e\u0902\u0917\u0932\u093e \u0906\u0930\u0924\u0940: 05:30 AM, \u092e\u093e\u0916\u0928\u092d\u094b\u0917 \u0906\u0930\u0924\u0940: 08:00 AM, \u0938\u0902\u0927\u094d\u092f\u093e \u0906\u0930\u0924\u0940: 06:30 PM"},location:"\u0921\u0940\u0917 \u0917\u0947\u091f, \u092e\u0925\u0941\u0930\u093e",festivals:["\u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u091c\u0928\u094d\u092e\u093e\u0937\u094d\u091f\u092e\u0940","\u0930\u093e\u0927\u093e\u0937\u094d\u091f\u092e\u0940","\u0926\u0940\u092a\u093e\u0935\u0932\u0940","\u0939\u094b\u0932\u0940 \u092e\u0939\u094b\u0924\u094d\u0938\u0935"],darshanTips:"\u092a\u0930\u093f\u0938\u0930 \u092e\u0947\u0902 \u0915\u0948\u092e\u0930\u093e, \u092e\u094b\u092c\u093e\u0907\u0932 \u092b\u094b\u0928 \u0914\u0930 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0917\u0948\u091c\u0947\u091f\u094d\u0938 \u0932\u0947 \u091c\u093e\u0928\u093e \u092a\u0942\u0930\u094d\u0923\u0924\u0903 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u0939\u0948; \u0915\u094d\u0932\u0949\u0915 \u0930\u0942\u092e \u092e\u0947\u0902 \u091c\u092e\u093e \u0915\u0930\u0947\u0902\u0964"},{id:3,name:"Prem Mandir",nameHindi:"\u092a\u094d\u0930\u0947\u092e \u092e\u0902\u0926\u093f\u0930",city:"Vrindavan",cityHindi:"\u0935\u0943\u0902\u0926\u093e\u0935\u0928",deity:"Shri Radha Krishna & Shri Sita Ram",deityHindi:"\u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e \u0915\u0943\u0937\u094d\u0923 \u090f\u0935\u0902 \u0936\u094d\u0930\u0940 \u0938\u0940\u0924\u093e \u0930\u093e\u092e",image:"/images/temples/prem-mandir.avif",latitude:27.5714,longitude:77.6726,featured:!0,tagline:"The Divine Monument of Eternal Love & Light",taglineHindi:"\u0926\u093f\u0935\u094d\u092f \u092a\u094d\u0930\u0947\u092e \u0914\u0930 \u0938\u0902\u0917\u092e\u0930\u092e\u0930\u0940 \u092a\u094d\u0930\u0915\u093e\u0936 \u0915\u093e \u092d\u0935\u094d\u092f \u0938\u094d\u092e\u093e\u0930\u0915",shortDescription:"\u0907\u091f\u0948\u0932\u093f\u092f\u0928 \u0915\u0930\u093e\u0930\u093e \u0938\u0902\u0917\u092e\u0930\u092e\u0930 \u0938\u0947 \u0928\u093f\u0930\u094d\u092e\u093f\u0924 \u092d\u0935\u094d\u092f \u092e\u0902\u0926\u093f\u0930, \u091c\u0939\u093e\u0901 \u092d\u0917\u0935\u093e\u0928 \u0915\u0943\u0937\u094d\u0923 \u0915\u0940 \u092c\u093e\u0932 \u0932\u0940\u0932\u093e\u0913\u0902 \u0914\u0930 \u0938\u0902\u0927\u094d\u092f\u093e \u0915\u093e\u0932\u0940\u0928 \u092e\u094d\u092f\u0942\u091c\u093f\u0915\u0932 \u0932\u093e\u0907\u091f \u0936\u094b \u0915\u093e \u0905\u0926\u094d\u092d\u0941\u0924 \u0938\u0902\u0917\u092e \u0939\u0948\u0964",shortDescriptionEn:"A breathtaking temple sculpted from Italian Carrara marble, featuring life-size dioramas of Krishna's pastimes and musical fountain shows.",history:"\u091c\u0917\u0926\u094d\u0917\u0941\u0930\u0941 \u0915\u0943\u092a\u093e\u0932\u0941 \u091c\u0940 \u092e\u0939\u093e\u0930\u093e\u091c \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u094d\u0925\u093e\u092a\u093f\u0924\u0964 \u0907\u0938 \u092e\u0902\u0926\u093f\u0930 \u0915\u0940 \u0906\u0927\u093e\u0930\u0936\u093f\u0932\u093e 2001 \u092e\u0947\u0902 \u0930\u0916\u0940 \u0917\u0908 \u0914\u0930 2012 \u092e\u0947\u0902 \u0907\u0938\u0915\u093e \u092d\u0935\u094d\u092f \u0932\u094b\u0915\u093e\u0930\u094d\u092a\u0923 \u0939\u0941\u0906\u0964 \u092f\u0939\u093e\u0901 30,000 \u091f\u0928 \u0936\u0941\u0926\u094d\u0927 \u0907\u091f\u0948\u0932\u093f\u092f\u0928 \u092e\u093e\u0930\u094d\u092c\u0932 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0939\u0941\u0906 \u0939\u0948\u0964",architecture:"\u0906\u0927\u0941\u0928\u093f\u0915 \u090f\u0935\u0902 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0928\u093e\u0917\u0930 \u0936\u0948\u0932\u0940 \u0915\u093e \u092b\u094d\u092f\u0942\u091c\u0928, 125 \u092b\u0940\u091f \u090a\u0902\u091a\u093e, 122 \u092b\u0940\u091f \u091a\u094c\u0921\u093c\u093e \u0914\u0930 115 \u092b\u0940\u091f \u0932\u0902\u092c\u093e \u0936\u0941\u0926\u094d\u0927 \u0938\u092b\u0947\u0926 \u092e\u093e\u0930\u094d\u092c\u0932 \u0938\u094d\u091f\u094d\u0930\u0915\u094d\u091a\u0930\u0964",timings:{summer:"\u092a\u094d\u0930\u093e\u0924\u0903 05:30 \u0938\u0947 12:00, \u0938\u093e\u092f\u0902 04:30 \u0938\u0947 \u0930\u093e\u0924\u094d\u0930\u093f 08:30",winter:"\u092a\u094d\u0930\u093e\u0924\u0903 05:30 \u0938\u0947 12:00, \u0938\u093e\u092f\u0902 04:30 \u0938\u0947 \u0930\u093e\u0924\u094d\u0930\u093f 08:30",aarti:"\u0906\u0930\u0924\u0940: 05:30 AM, 12:00 PM, 04:30 PM, 08:15 PM | \u092e\u094d\u092f\u0942\u091c\u093f\u0915\u0932 \u092b\u093e\u0909\u0902\u091f\u0947\u0928 \u0936\u094b: 07:30 PM - 08:00 PM"},location:"\u091b\u091f\u0940\u0915\u0930\u093e \u0930\u094b\u0921, \u0930\u092e\u0928 \u0930\u0947\u0924\u0940, \u0935\u0943\u0902\u0926\u093e\u0935\u0928",festivals:["\u091c\u0928\u094d\u092e\u093e\u0937\u094d\u091f\u092e\u0940","\u0930\u093e\u0938 \u092a\u0942\u0930\u094d\u0923\u093f\u092e\u093e","\u0939\u094b\u0932\u0940","\u0928\u0935 \u0935\u0930\u094d\u0937"],darshanTips:"\u0936\u093e\u092e 6:30 \u092c\u091c\u0947 \u091c\u093e\u090f\u0902 \u0924\u093e\u0915\u093f \u0906\u092a \u092e\u0902\u0926\u093f\u0930 \u0915\u0940 \u0938\u0941\u0902\u0926\u0930 \u0932\u093e\u0907\u091f\u093f\u0902\u0917 \u0914\u0930 \u0938\u0902\u0917\u0940\u0924\u092e\u092f \u092b\u0935\u094d\u0935\u093e\u0930\u093e \u0936\u094b \u0915\u093e \u0906\u0928\u0902\u0926 \u0932\u0947 \u0938\u0915\u0947\u0902\u0964"},{id:4,name:"Shri Radha Rani Mandir (Barsana)",nameHindi:"\u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u092e\u0902\u0926\u093f\u0930 (\u0932\u093e\u0921\u093c\u0932\u0940 \u091c\u0940)",city:"Barsana",cityHindi:"\u092c\u0930\u0938\u093e\u0928\u093e",deity:"Shri Radha Rani (Laadli Ji)",deityHindi:"\u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 (\u0932\u093e\u0921\u093c\u0932\u0940 \u091c\u0940)",image:"/images/temples/radha-rani.avif",latitude:27.6477,longitude:77.3752,featured:!0,tagline:"The Palace of Vrishabhanu's Beloved Daughter on Bhanugarh Hill",taglineHindi:"\u092d\u093e\u0928\u0941\u0917\u0922\u093c \u092a\u0930\u094d\u0935\u0924 \u092a\u0930 \u0935\u093f\u0930\u093e\u091c\u093f\u0924 \u0935\u0943\u0937\u092d\u093e\u0928\u0941 \u0926\u0941\u0932\u093e\u0930\u0940 \u0915\u093e \u092a\u093e\u0935\u0928 \u092e\u0939\u0932",shortDescription:"\u092d\u093e\u0928\u0941\u0917\u0922\u093c \u092a\u0930\u094d\u0935\u0924 \u092a\u0930 \u0938\u094d\u0925\u093f\u0924 \u0932\u093e\u0921\u093c\u0932\u0940 \u091c\u0940 \u0915\u093e \u092e\u0939\u0932, \u091c\u0939\u093e\u0901 \u0935\u093f\u0936\u094d\u0935 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u092c\u0930\u0938\u093e\u0928\u0947 \u0915\u0940 \u0932\u0920\u092e\u093e\u0930 \u0939\u094b\u0932\u0940 \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",shortDescriptionEn:"The palace of Laadli Ji atop Bhanugarh hill, famous worldwide for the historic Lathmar Holi celebration.",history:"\u092d\u093e\u0928\u0941\u0917\u0922\u093c \u092a\u0939\u093e\u0921\u093c\u0940 \u092a\u0930 \u0938\u094d\u0925\u093f\u0924 \u092f\u0939 \u092e\u0939\u0932 \u0930\u093e\u091c\u093e \u0935\u0943\u0937\u092d\u093e\u0928\u0941 \u0914\u0930 \u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u0915\u093e \u0928\u093f\u0935\u093e\u0938 \u0938\u094d\u0925\u093e\u0928 \u0930\u0939\u093e \u0939\u0948\u0964 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0902\u0926\u093f\u0930 \u0915\u093e \u091c\u0940\u0930\u094d\u0923\u094b\u0926\u094d\u0927\u093e\u0930 1675 \u0908\u0938\u094d\u0935\u0940 \u092e\u0947\u0902 \u0930\u093e\u091c\u093e \u0935\u0940\u0930 \u0938\u093f\u0902\u0939 \u0926\u0947\u0935 \u0928\u0947 \u0915\u0930\u0935\u093e\u092f\u093e \u0925\u093e\u0964",architecture:"\u0932\u093e\u0932 \u0914\u0930 \u092a\u0940\u0932\u0947 \u092c\u0932\u0941\u0906 \u092a\u0924\u094d\u0925\u0930 (Red Sandstone) \u0938\u0947 \u0928\u093f\u0930\u094d\u092e\u093f\u0924 \u092e\u0927\u094d\u092f\u0915\u093e\u0932\u0940\u0928 \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928\u0940 \u092e\u0939\u0932 \u0936\u0948\u0932\u0940\u0964",timings:{summer:"\u092a\u094d\u0930\u093e\u0924\u0903 05:00 \u0938\u0947 \u0926\u094b\u092a\u0939\u0930 02:00, \u0938\u093e\u092f\u0902 05:00 \u0938\u0947 \u0930\u093e\u0924\u094d\u0930\u093f 09:00",winter:"\u092a\u094d\u0930\u093e\u0924\u0903 05:30 \u0938\u0947 \u0926\u094b\u092a\u0939\u0930 02:00, \u0938\u093e\u092f\u0902 04:30 \u0938\u0947 \u0930\u093e\u0924\u094d\u0930\u093f 08:30",aarti:"\u092e\u0902\u0917\u0932\u093e: 05:30 AM, \u092d\u094b\u0917: 12:00 PM, \u0938\u0902\u0927\u094d\u092f\u093e: 07:00 PM"},location:"\u092d\u093e\u0928\u0941\u0917\u0922\u093c \u092a\u0930\u094d\u0935\u0924, \u092c\u0930\u0938\u093e\u0928\u093e",festivals:["\u0932\u0920\u092e\u093e\u0930 \u0939\u094b\u0932\u0940","\u0930\u093e\u0927\u093e\u0937\u094d\u091f\u092e\u0940 (\u092e\u0939\u093e\u092e\u0939\u094b\u0924\u094d\u0938\u0935)","\u0917\u094b\u092a\u093e\u0937\u094d\u091f\u092e\u0940"],darshanTips:"\u092e\u0902\u0926\u093f\u0930 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0932\u0917\u092d\u0917 200 \u0938\u0940\u0922\u093c\u093f\u092f\u093e\u0902 \u0939\u0948\u0902; \u0935\u0943\u0926\u094d\u0927 \u091c\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0921\u094b\u0932\u0940 \u0914\u0930 \u0930\u094b\u092a\u0935\u0947 \u0915\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964"},{id:5,name:"Daan Ghati Mandir (Govardhan)",nameHindi:"\u0926\u093e\u0928\u0918\u093e\u091f\u0940 \u092e\u0902\u0926\u093f\u0930 (\u0917\u094b\u0935\u0930\u094d\u0927\u0928)",city:"Govardhan",cityHindi:"\u0917\u094b\u0935\u0930\u094d\u0927\u0928",deity:"Giriraj Maharaj (Govardhan Shila)",deityHindi:"\u0917\u093f\u0930\u093f\u0930\u093e\u091c \u092e\u0939\u093e\u0930\u093e\u091c (\u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u0936\u093f\u0932\u093e)",image:"/images/temples/dwarkadhish.avif",latitude:27.4998,longitude:77.4649,featured:!0,tagline:"The Centerpiece of the 21-Kilometer Sacred Parikrama",taglineHindi:"21 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0938\u092a\u094d\u0924\u0915\u094b\u0938\u0940\u092f \u0917\u093f\u0930\u093f\u0930\u093e\u091c \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u093e \u092a\u094d\u0930\u092e\u0941\u0916 \u0915\u0947\u0902\u0926\u094d\u0930",shortDescription:"\u091c\u0939\u093e\u0901 \u092c\u093e\u0932 \u0915\u0943\u0937\u094d\u0923 \u0917\u094b\u092a\u093f\u092f\u094b\u0902 \u0938\u0947 \u0926\u093e\u0928 (\u092e\u093e\u0916\u0928) \u092e\u093e\u0902\u0917\u093e \u0915\u0930\u0924\u0947 \u0925\u0947; 21 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0917\u093f\u0930\u093f\u0930\u093e\u091c \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u093e \u092a\u094d\u0930\u092e\u0941\u0916 \u0906\u0930\u0902\u092d \u0938\u094d\u0925\u0932\u0964",shortDescriptionEn:"The place where young Krishna playfully demanded tax from Gopis; key starting point for 21 km Govardhan Parikrama.",history:"\u092f\u0939 \u0935\u0939 \u0938\u094d\u0925\u093e\u0928 \u0939\u0948 \u091c\u0939\u093e\u0901 \u092d\u0917\u0935\u093e\u0928 \u0915\u0943\u0937\u094d\u0923 \u0928\u0947 \u0907\u0902\u0926\u094d\u0930 \u0915\u093e \u092e\u093e\u0928\u092e\u0930\u094d\u0926\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 7 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092a\u0930\u094d\u0935\u0924 \u0915\u094b \u0905\u092a\u0928\u0940 \u0915\u0928\u093f\u0937\u094d\u0920\u093f\u0915\u093e (\u091b\u094b\u091f\u0940 \u0909\u0902\u0917\u0932\u0940) \u092a\u0930 \u0927\u093e\u0930\u0923 \u0915\u093f\u092f\u093e \u0925\u093e\u0964",architecture:"\u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0917\u093f\u0930\u093f\u0930\u093e\u091c \u0936\u093f\u0932\u093e \u0935\u093f\u0917\u094d\u0930\u0939 \u0930\u0942\u092a, \u0926\u0942\u0927 \u0914\u0930 \u0917\u0902\u0917\u093e\u091c\u0932 \u0905\u092d\u093f\u0937\u0947\u0915 \u0915\u0940 \u0935\u093f\u0936\u0947\u0937 \u0938\u0902\u0930\u091a\u0928\u093e\u0964",timings:{summer:"\u092a\u094d\u0930\u093e\u0924\u0903 05:00 \u0938\u0947 \u0930\u093e\u0924\u094d\u0930\u093f 11:00 (\u0905\u0935\u093f\u0930\u0932 \u0926\u0930\u094d\u0936\u0928)",winter:"\u092a\u094d\u0930\u093e\u0924\u0903 05:30 \u0938\u0947 \u0930\u093e\u0924\u094d\u0930\u093f 10:30",aarti:"\u092e\u0902\u0917\u0932\u093e \u0906\u0930\u0924\u0940: 05:30 AM, \u0926\u0941\u0917\u094d\u0927\u093e\u092d\u093f\u0937\u0947\u0915: \u0926\u093f\u0928\u092d\u0930, \u0936\u092f\u0928 \u0906\u0930\u0924\u0940: 10:00 PM"},location:"\u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u092e\u093e\u0930\u094d\u0917, \u0917\u094b\u0935\u0930\u094d\u0927\u0928, \u092e\u0925\u0941\u0930\u093e",festivals:["\u0905\u0928\u094d\u0928\u0915\u0942\u091f (\u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092a\u0942\u091c\u093e)","\u0917\u0941\u0930\u0941 \u092a\u0942\u0930\u094d\u0923\u093f\u092e\u093e (\u092e\u0941\u0921\u093c\u093f\u092f\u093e \u092a\u0942\u0928\u094b\u0902 \u092e\u0947\u0932\u093e)","\u0926\u0940\u092a\u093e\u0935\u0932\u0940"],darshanTips:"\u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0939\u092e\u0947\u0936\u093e \u0928\u0902\u0917\u0947 \u092a\u0948\u0930 \u092f\u093e \u0906\u0930\u093e\u092e\u0926\u093e\u092f\u0915 \u091c\u0942\u0924\u094b\u0902 \u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u0924\u0903\u0915\u093e\u0932 \u092f\u093e \u0936\u093e\u092e \u0915\u0947 \u0938\u092e\u092f \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964"},{id:6,name:"Dwarkadhish Temple (Mathura)",nameHindi:"\u0936\u094d\u0930\u0940 \u0926\u094d\u0935\u093e\u0930\u093f\u0915\u093e\u0927\u0940\u0936 \u092e\u0902\u0926\u093f\u0930",city:"Mathura",cityHindi:"\u092e\u0925\u0941\u0930\u093e",deity:"Lord Krishna as Dwarkanath & Rukmini Devi",deityHindi:"\u0926\u094d\u0935\u093e\u0930\u093f\u0915\u093e\u0928\u093e\u0925 \u0930\u0942\u092a \u092e\u0947\u0902 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u090f\u0935\u0902 \u0930\u0941\u0915\u094d\u092e\u093f\u0923\u0940 \u091c\u0940",image:"/images/temples/gokul.avif",latitude:27.5029,longitude:77.6841,featured:!0,tagline:"The Royal Abode of the King of Dwarka in Mathura",taglineHindi:"\u092e\u0925\u0941\u0930\u093e \u092e\u0947\u0902 \u0926\u094d\u0935\u093e\u0930\u093f\u0915\u093e \u0928\u0930\u0947\u0936 \u0915\u093e \u092d\u0935\u094d\u092f \u090f\u0935\u0902 \u0935\u0948\u092d\u0935\u0936\u093e\u0932\u0940 \u0927\u093e\u092e",shortDescription:"\u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f \u0915\u0947 \u0938\u092e\u0940\u092a \u0938\u094d\u0925\u093f\u0924 \u092a\u0941\u0937\u094d\u091f\u093f\u092e\u093e\u0930\u094d\u0917\u0940\u092f \u0935\u0948\u0937\u094d\u0923\u0935 \u0938\u0902\u092a\u094d\u0930\u0926\u093e\u092f \u0915\u093e \u0905\u0924\u093f \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0914\u0930 \u0935\u0948\u092d\u0935\u0936\u093e\u0932\u0940 \u092e\u0902\u0926\u093f\u0930\u0964",shortDescriptionEn:"An ancient, opulent Pushtimarg temple near Vishram Ghat depicting the royal form of King of Dwarka.",history:"1814 \u092e\u0947\u0902 \u0917\u094d\u0935\u093e\u0932\u093f\u092f\u0930 \u0930\u093f\u092f\u093e\u0938\u0924 \u0915\u0947 \u0915\u094b\u0937\u093e\u0927\u094d\u092f\u0915\u094d\u0937 \u0938\u0947\u0920 \u0917\u094b\u0915\u0941\u0932\u0926\u093e\u0938 \u092a\u093e\u0930\u093f\u0916 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u0930\u094d\u092e\u093f\u0924\u0964 \u092f\u0939 \u092e\u0902\u0926\u093f\u0930 \u092a\u0941\u0937\u094d\u091f\u093f\u092e\u093e\u0930\u094d\u0917\u0940\u092f (\u0935\u0932\u094d\u0932\u092d \u0915\u0941\u0932) \u092a\u0930\u0902\u092a\u0930\u093e \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",architecture:"\u0935\u093f\u0936\u093e\u0932 \u0906\u0902\u0917\u0928, \u0928\u0915\u094d\u0915\u093e\u0936\u0940\u0926\u093e\u0930 \u0916\u0902\u092d\u0947 \u0914\u0930 \u091b\u0924 \u092a\u0930 \u091a\u093f\u0924\u094d\u0930\u093f\u0924 \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928\u0940 \u0915\u0943\u0937\u094d\u0923 \u0932\u0940\u0932\u093e \u092d\u093f\u0924\u094d\u0924\u093f\u091a\u093f\u0924\u094d\u0930\u0964",timings:{summer:"\u092a\u094d\u0930\u093e\u0924\u0903 06:30 \u0938\u0947 10:30, \u0938\u093e\u092f\u0902 04:00 \u0938\u0947 07:00",winter:"\u092a\u094d\u0930\u093e\u0924\u0903 07:00 \u0938\u0947 11:00, \u0938\u093e\u092f\u0902 03:30 \u0938\u0947 06:30",aarti:"\u092e\u0902\u0917\u0932\u093e: 06:30 AM, \u0936\u094d\u0930\u0943\u0902\u0917\u093e\u0930: 07:30 AM, \u0930\u093e\u091c\u092d\u094b\u0917: 10:00 AM, \u0938\u0902\u0927\u094d\u092f\u093e: 06:00 PM"},location:"\u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f \u0915\u0947 \u092a\u093e\u0938, \u0928\u092f\u093e \u092c\u093e\u091c\u093e\u0930, \u092e\u0925\u0941\u0930\u093e",festivals:["\u0939\u093f\u0902\u0921\u094b\u0932\u093e \u0909\u0924\u094d\u0938\u0935 (\u0938\u093e\u0935\u0928)","\u091c\u0928\u094d\u092e\u093e\u0937\u094d\u091f\u092e\u0940","\u0939\u094b\u0932\u0940 \u0921\u094b\u0932\u094b\u0924\u094d\u0938\u0935"],darshanTips:"\u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f \u092a\u0930 \u092f\u092e\u0941\u0928\u093e \u091c\u0940 \u0915\u0940 \u0938\u0902\u0927\u094d\u092f\u093e \u0906\u0930\u0924\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0926\u094d\u0935\u093e\u0930\u093f\u0915\u093e\u0927\u0940\u0936 \u0926\u0930\u094d\u0936\u0928 \u0915\u093e \u0938\u092e\u092f \u092e\u093f\u0932\u093e\u0915\u0930 \u092a\u094d\u0932\u093e\u0928 \u0915\u0930\u0947\u0902\u0964"},{id:7,name:"Raman Reti",nameHindi:"\u0930\u092e\u0923 \u0930\u0947\u0924\u0940",city:"Gokul",cityHindi:"\u0917\u094b\u0915\u0941\u0932",deity:"Lord Krishna & Radha",deityHindi:"\u092c\u093e\u0932 \u0915\u0943\u0937\u094d\u0923 \u090f\u0935\u0902 \u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e",image:"/images/temples/raman-reti.png",latitude:27.4379,longitude:77.7214,featured:!1,tagline:"The Sacred Land of Krishna's Childhood Pastimes",taglineHindi:"\u092c\u093e\u0932 \u0915\u0943\u0937\u094d\u0923 \u0915\u0940 \u0927\u0942\u0932\u093f \u0927\u0942\u0938\u0930\u093f\u0924 \u092a\u093e\u0935\u0928 \u0915\u094d\u0930\u0940\u0921\u093c\u093e \u0938\u094d\u0925\u0932\u0940",shortDescription:"\u0917\u094b\u0915\u0941\u0932 \u0915\u0947 \u092a\u093e\u0938 \u0938\u094d\u0925\u093f\u0924 \u0930\u092e\u0923 \u0930\u0947\u0924\u0940 \u092c\u094d\u0930\u091c \u0915\u093e \u090f\u0915 \u0936\u093e\u0902\u0924 \u0914\u0930 \u092a\u0935\u093f\u0924\u094d\u0930 \u0938\u094d\u0925\u0932 \u0939\u0948, \u091c\u093f\u0938\u0947 \u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940\u0915\u0943\u0937\u094d\u0923 \u0915\u0940 \u092c\u093e\u0932 \u0932\u0940\u0932\u093e\u0913\u0902 \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",shortDescriptionEn:"A tranquil sanctuary near Gokul where devotees roll in the holy sands blessed by Krishna's infant footsteps.",history:"\u0930\u092e\u0923 \u0930\u0947\u0924\u0940 \u092c\u094d\u0930\u091c \u0915\u0940 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092a\u0930\u0902\u092a\u0930\u093e\u0913\u0902 \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0938\u094d\u0925\u0932 \u0939\u0948\u0964 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u0939\u0948 \u0915\u093f \u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940\u0915\u0943\u0937\u094d\u0923 \u0914\u0930 \u0909\u0928\u0915\u0947 \u0938\u0916\u093e \u092f\u0939\u093e\u0901 \u0916\u0947\u0932\u093e \u0915\u0930\u0924\u0947 \u0925\u0947 \u0924\u0925\u093e \u092f\u0939 \u0938\u094d\u0925\u093e\u0928 \u0909\u0928\u0915\u0940 \u092c\u093e\u0932 \u0932\u0940\u0932\u093e\u0913\u0902 \u0915\u0940 \u0938\u094d\u092e\u0943\u0924\u093f\u092f\u094b\u0902 \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906 \u0939\u0948\u0964",architecture:"\u092f\u0939 \u0938\u094d\u0925\u0932 \u0905\u092a\u0928\u0947 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0935\u093e\u0924\u093e\u0935\u0930\u0923, \u092a\u0935\u093f\u0924\u094d\u0930 \u0930\u0947\u0924 \u0914\u0930 \u0906\u0938\u092a\u093e\u0938 \u0938\u094d\u0925\u093f\u0924 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092e\u0902\u0926\u093f\u0930\u094b\u0902 \u090f\u0935\u0902 \u0906\u0936\u094d\u0930\u092e\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0935\u093f\u0936\u0947\u0937 \u0906\u0915\u0930\u094d\u0937\u0923 \u0930\u0916\u0924\u093e \u0939\u0948\u0964",timings:{summer:"\u092a\u094d\u0930\u093e\u0924\u0903 06:00 \u0938\u0947 12:00, \u0938\u093e\u092f\u0902 04:00 \u0938\u0947 08:00",winter:"\u092a\u094d\u0930\u093e\u0924\u0903 06:30 \u0938\u0947 12:00, \u0938\u093e\u092f\u0902 03:30 \u0938\u0947 07:30",aarti:"\u092a\u094d\u0930\u093e\u0924\u0903 \u090f\u0935\u0902 \u0938\u093e\u092f\u0902\u0915\u093e\u0932\u0940\u0928 \u0906\u0930\u0924\u0940"},location:"\u0930\u092e\u0923 \u0930\u0947\u0924\u0940, \u0917\u094b\u0915\u0941\u0932, \u092e\u0925\u0941\u0930\u093e",festivals:["\u091c\u0928\u094d\u092e\u093e\u0937\u094d\u091f\u092e\u0940","\u0939\u094b\u0932\u0940","\u0930\u093e\u0927\u093e\u0937\u094d\u091f\u092e\u0940","\u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092a\u0942\u091c\u093e"],darshanTips:"\u0938\u0941\u092c\u0939 \u0914\u0930 \u0936\u093e\u092e \u0915\u093e \u0938\u092e\u092f \u092f\u0939\u093e\u0901 \u0915\u0947 \u0936\u093e\u0902\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0915\u093e \u0906\u0928\u0902\u0926 \u0932\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u0947\u0939\u0924\u0930 \u0930\u0939\u0924\u093e \u0939\u0948\u0964"},{id:8,name:"Dauji Temple (Baldev)",nameHindi:"\u0926\u093e\u090a\u091c\u0940 \u092e\u0902\u0926\u093f\u0930 (\u092c\u0932\u0926\u0947\u0935)",city:"Baldev",cityHindi:"\u092c\u0932\u0926\u0947\u0935",deity:"Lord Balarama (Dauji)",deityHindi:"\u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940 \u092c\u0932\u0930\u093e\u092e (\u0926\u093e\u090a\u091c\u0940 \u092e\u0939\u093e\u0930\u093e\u091c)",image:"/images/temples/dauji.png",latitude:27.4116,longitude:77.8188,featured:!1,tagline:"The Sacred Abode of Lord Balarama in Braj",taglineHindi:"\u092c\u094d\u0930\u091c \u0915\u0947 \u0930\u093e\u091c\u093e \u0926\u093e\u090a\u0926\u092f\u093e\u0932 \u092c\u0932\u0930\u093e\u092e \u091c\u0940 \u0915\u093e \u092a\u093e\u0935\u0928 \u0927\u093e\u092e",shortDescription:"\u092c\u0932\u0926\u0947\u0935 \u092e\u0947\u0902 \u0938\u094d\u0925\u093f\u0924 \u0926\u093e\u090a\u091c\u0940 \u092e\u0902\u0926\u093f\u0930 \u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940\u0915\u0943\u0937\u094d\u0923 \u0915\u0947 \u092c\u0921\u093c\u0947 \u092d\u093e\u0908 \u092d\u0917\u0935\u093e\u0928 \u092c\u0932\u0930\u093e\u092e \u091c\u0940 \u0915\u094b \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u092c\u094d\u0930\u091c \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u093e \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0938\u094d\u0925\u0932 \u0939\u0948\u0964",shortDescriptionEn:"Dedicated to Krishna's elder brother Lord Balarama, housing an awe-inspiring massive ancient deity.",history:"\u0926\u093e\u090a\u091c\u0940 \u092e\u0902\u0926\u093f\u0930 \u092c\u094d\u0930\u091c \u0915\u0940 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092a\u0930\u0902\u092a\u0930\u093e \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906 \u0939\u0948\u0964 \u092f\u0939\u093e\u0901 \u092d\u0917\u0935\u093e\u0928 \u092c\u0932\u0930\u093e\u092e \u091c\u0940 \u0915\u0940 \u092a\u0942\u091c\u093e \u0926\u093e\u090a\u091c\u0940 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0914\u0930 \u092f\u0939 \u092e\u0902\u0926\u093f\u0930 \u092c\u094d\u0930\u091c \u0915\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0924\u0940\u0930\u094d\u0925 \u0938\u094d\u0925\u0932\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u0936\u0947\u0937 \u0938\u094d\u0925\u093e\u0928 \u0930\u0916\u0924\u093e \u0939\u0948\u0964",architecture:"\u092e\u0902\u0926\u093f\u0930 \u092a\u0930\u093f\u0938\u0930 \u092e\u0947\u0902 \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u092c\u094d\u0930\u091c \u0938\u094d\u0925\u093e\u092a\u0924\u094d\u092f, \u0935\u093f\u0936\u093e\u0932 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092a\u094d\u0930\u093e\u0902\u0917\u0923 \u0914\u0930 \u0938\u0941\u0902\u0926\u0930 \u092e\u0902\u0926\u093f\u0930 \u0938\u0902\u0930\u091a\u0928\u093e \u0926\u0947\u0916\u0928\u0947 \u0915\u094b \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964",timings:{summer:"\u092a\u094d\u0930\u093e\u0924\u0903 06:00 \u0938\u0947 12:00, \u0938\u093e\u092f\u0902 04:00 \u0938\u0947 09:00",winter:"\u092a\u094d\u0930\u093e\u0924\u0903 06:30 \u0938\u0947 12:00, \u0938\u093e\u092f\u0902 03:30 \u0938\u0947 08:30",aarti:"\u092e\u0902\u0917\u0932\u093e \u0906\u0930\u0924\u0940, \u0930\u093e\u091c\u092d\u094b\u0917 \u090f\u0935\u0902 \u0938\u0902\u0927\u094d\u092f\u093e \u0906\u0930\u0924\u0940"},location:"\u092c\u0932\u0926\u0947\u0935 \u0928\u0917\u0930, \u092e\u0925\u0941\u0930\u093e",festivals:["\u092c\u0932\u0930\u093e\u092e \u091c\u092f\u0902\u0924\u0940","\u0939\u094b\u0932\u0940","\u091c\u0928\u094d\u092e\u093e\u0937\u094d\u091f\u092e\u0940","\u0932\u091f\u094d\u0920\u092e\u093e\u0930 \u0939\u094b\u0932\u0940"],darshanTips:"\u0935\u093f\u0936\u0947\u0937 \u0924\u094d\u092f\u094b\u0939\u093e\u0930\u094b\u0902 \u0914\u0930 \u092e\u0947\u0932\u094b\u0902 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u092f\u0939\u093e\u0901 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941\u0913\u0902 \u0915\u0940 \u092d\u0940\u0921\u093c \u0915\u093e\u092b\u0940 \u092c\u0922\u093c \u0938\u0915\u0924\u0940 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0938\u092e\u092f \u0930\u0916\u0947\u0902\u0964"},{id:9,name:"Chandrawal Maiya Temple",nameHindi:"\u091a\u0902\u0926\u094d\u0930\u093e\u0935\u0932 \u092e\u0948\u092f\u093e \u092e\u0902\u0926\u093f\u0930",city:"Mathura",cityHindi:"\u092e\u0925\u0941\u0930\u093e",deity:"Chandrawal Maiya",deityHindi:"\u0938\u0916\u0940 \u091a\u0902\u0926\u094d\u0930\u093e\u0935\u0932 \u092e\u0948\u092f\u093e",image:"/images/temples/chandrawal-maiya.png",latitude:27.4912,longitude:77.6789,featured:!1,tagline:"A Sacred Shrine of Braj's Folk Devotion",taglineHindi:"\u092c\u094d\u0930\u091c \u0915\u0940 \u0932\u094b\u0915 \u0906\u0938\u094d\u0925\u093e \u090f\u0935\u0902 \u0938\u0916\u0940 \u092d\u093e\u0935 \u0915\u093e \u0936\u094d\u0930\u0926\u094d\u0927\u093e \u0915\u0947\u0902\u0926\u094d\u0930",shortDescription:"\u091a\u0902\u0926\u094d\u0930\u093e\u0935\u0932 \u092e\u0948\u092f\u093e \u092e\u0902\u0926\u093f\u0930 \u092c\u094d\u0930\u091c \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0940 \u0932\u094b\u0915 \u0906\u0938\u094d\u0925\u093e \u0914\u0930 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092a\u0930\u0902\u092a\u0930\u093e\u0913\u0902 \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u090f\u0915 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u092a\u0942\u0930\u094d\u0923 \u0926\u0947\u0935\u0940 \u0938\u094d\u0925\u0932 \u0939\u0948\u0964",shortDescriptionEn:"A revered shrine commemorating the devotion of Sakhi Chandrawali in Braj folklore.",history:"\u091a\u0902\u0926\u094d\u0930\u093e\u0935\u0932 \u092e\u0948\u092f\u093e \u0915\u0940 \u092a\u0942\u091c\u093e \u092c\u094d\u0930\u091c \u0915\u0940 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u090f\u0935\u0902 \u0932\u094b\u0915 \u092a\u0930\u0902\u092a\u0930\u093e\u0913\u0902 \u092e\u0947\u0902 \u0935\u093f\u0936\u0947\u0937 \u092e\u0939\u0924\u094d\u0935 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u092f\u0939\u093e\u0901 \u0926\u0947\u0935\u0940 \u0915\u0947 \u0926\u0930\u094d\u0936\u0928, \u092a\u0942\u091c\u093e \u0914\u0930 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u0924\u0947 \u0939\u0948\u0902\u0964",architecture:"\u092e\u0902\u0926\u093f\u0930 \u0915\u0940 \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0938\u0902\u0930\u091a\u0928\u093e, \u0926\u0947\u0935\u0940 \u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0914\u0930 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092c\u094d\u0930\u091c \u0936\u0948\u0932\u0940 \u0915\u093e \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0907\u0938\u0947 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0936\u0947\u0937 \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964",timings:{summer:"\u092a\u094d\u0930\u093e\u0924\u0903 06:00 \u0938\u0947 12:00, \u0938\u093e\u092f\u0902 04:00 \u0938\u0947 08:00",winter:"\u092a\u094d\u0930\u093e\u0924\u0903 06:30 \u0938\u0947 12:00, \u0938\u093e\u092f\u0902 03:30 \u0938\u0947 07:30",aarti:"\u092a\u094d\u0930\u093e\u0924\u0903 \u0906\u0930\u0924\u0940 \u090f\u0935\u0902 \u