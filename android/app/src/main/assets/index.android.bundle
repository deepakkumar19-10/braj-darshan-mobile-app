__d(function(a,e,s,i,t,n,d){t.exports=[{id:"govardhan",title:"\u0936\u094d\u0930\u0940 \u0917\u094b\u0935\u0930\u094d\u0927\u0928 21 \u0915\u093f\u092e\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e",titleEn:"Sri Govardhan 21 KM Parikrama",subtitle:"\u0938\u092a\u094d\u0924 \u0926\u093f\u0935\u0938\u0940\u092f \u0917\u093f\u0930\u093f\u0930\u093e\u091c \u0927\u093e\u0930\u0923 \u0935 \u092e\u0928\u094b\u0930\u0925 \u092a\u0942\u0930\u094d\u0924\u093f \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e",distance:"21 KM (\u092c\u0921\u093c\u0940 12 \u0915\u093f\u092e\u0940 + \u091b\u094b\u091f\u0940 9 \u0915\u093f\u092e\u0940)",duration:"5 - 7 \u0918\u0902\u091f\u0947 (\u092a\u0948\u0926\u0932) / 2.5 \u0918\u0902\u091f\u0947 (\u0908-\u0930\u093f\u0915\u094d\u0936\u093e)",difficulty:"\u092e\u0927\u094d\u092f\u092e (Moderate)",startPoint:"\u0926\u093e\u0928\u0918\u093e\u091f\u0940 \u092e\u0902\u0926\u093f\u0930 / \u092e\u093e\u0928\u0938\u0940 \u0917\u0902\u0917\u093e",bestTime:"\u092c\u094d\u0930\u0939\u094d\u092e \u092e\u0941\u0939\u0942\u0930\u094d\u0924 (\u092a\u094d\u0930\u093e\u0924\u0903 04:00 AM) \u092f\u093e \u0938\u093e\u092f\u0902 \u0915\u093e\u0932 (05:00 PM)",overview:"\u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0928\u0947 \u0926\u0947\u0935\u0930\u093e\u091c \u0907\u0902\u0926\u094d\u0930 \u0915\u0947 \u0905\u0939\u0902\u0915\u093e\u0930 \u0915\u094b \u0928\u0937\u094d\u091f \u0915\u0930\u0928\u0947 \u0914\u0930 \u0938\u092e\u0938\u094d\u0924 \u092c\u094d\u0930\u091c\u0935\u093e\u0938\u093f\u092f\u094b\u0902 \u0935 \u0917\u094c\u0935\u0902\u0936 \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u0939\u0947\u0924\u0941 \u0905\u092a\u0928\u0940 \u0915\u0928\u093f\u0937\u094d\u0920\u093f\u0915\u093e \u0909\u0902\u0917\u0932\u0940 \u092a\u0930 \u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092a\u0930\u094d\u0935\u0924 \u0915\u094b 7 \u0926\u093f\u0928 \u0914\u0930 7 \u0930\u093e\u0924 \u0927\u093e\u0930\u0923 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0917\u093f\u0930\u093f\u0930\u093e\u091c \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u0930\u0928\u0947 \u0938\u0947 \u091c\u0928\u094d\u092e-\u091c\u0928\u094d\u092e\u093e\u0902\u0924\u0930 \u0915\u0947 \u092a\u093e\u092a\u094b\u0902 \u0915\u093e \u0928\u093e\u0936 \u0914\u0930 \u0938\u092e\u0938\u094d\u0924 \u092e\u0928\u094b\u0915\u093e\u092e\u0928\u093e\u090f\u0902 \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964",sections:[{name:"\u092d\u093e\u0917 1: \u092c\u0921\u093c\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e (~12 \u0915\u093f\u092e\u0940)",stops:[{name:"\u0926\u093e\u0928\u0918\u093e\u091f\u0940 \u092e\u0902\u0926\u093f\u0930 (Danghati Temple)",desc:"\u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u093e \u092a\u094d\u0930\u092e\u0941\u0916 \u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u092c\u093f\u0902\u0926\u0941 \u091c\u0939\u093e\u0902 \u092d\u0917\u0935\u093e\u0928 \u0928\u0947 \u0917\u094b\u092a\u093f\u092f\u094b\u0902 \u0938\u0947 \u092e\u093e\u0916\u0928-\u0926\u093e\u0928 \u092e\u093e\u0902\u0917\u093e \u0925\u093e\u0964 \u092f\u0939\u093e\u0902 \u0917\u093f\u0930\u093f\u0930\u093e\u091c \u092e\u0941\u0916\u093e\u0930\u0935\u093f\u0902\u0926 \u092a\u0930 \u0926\u0941\u0917\u094d\u0927\u093e\u092d\u093f\u0937\u0947\u0915 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"},{name:"\u0906\u0928\u094d\u092f\u094c\u0930 \u0917\u093e\u0902\u0935 (Anyor Village)",desc:"\u0905\u0928\u094d\u0928\u0915\u0942\u091f \u092e\u0939\u094b\u0924\u094d\u0938\u0935 \u0915\u093e \u092a\u093e\u0935\u0928 \u0938\u094d\u0925\u0932 \u091c\u0939\u093e\u0902 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0928\u0947 '\u0906\u0928\u093f \u0914\u0930' (\u0914\u0930 \u0932\u093e\u0913) \u0915\u0939\u0915\u0930 \u092c\u094d\u0930\u091c\u0935\u093e\u0938\u093f\u092f\u094b\u0902 \u0915\u093e \u0938\u092e\u0938\u094d\u0924 56 \u092d\u094b\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u093f\u092f\u093e \u0925\u093e\u0964"},{name:"\u0917\u094b\u0935\u093f\u0902\u0926 \u0915\u0941\u0902\u0921 (Govind Kund)",desc:"\u0907\u0902\u0926\u094d\u0930\u0926\u0947\u0935 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u092a\u0928\u0940 \u092a\u0930\u093e\u091c\u092f \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0915\u093e\u092e\u0927\u0947\u0928\u0941 \u0917\u093e\u092f \u0915\u0947 \u0926\u0942\u0927 \u0914\u0930 \u0910\u0930\u093e\u0935\u0924 \u0939\u093e\u0925\u0940 \u0915\u0947 \u091c\u0932 \u0938\u0947 \u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0915\u093e \u0930\u093e\u091c\u094d\u092f\u093e\u092d\u093f\u0937\u0947\u0915 \u0938\u094d\u0925\u0932\u0964"},{name:"\u092a\u0942\u0902\u091b\u0930\u0940 \u0915\u093e \u0932\u094c\u0920\u093e (Poonchari Ka Lautha)",desc:"\u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0915\u0947 \u092c\u093e\u0932 \u0938\u0916\u093e \u0932\u094c\u0920\u093e \u091c\u0940 \u0915\u0940 \u0924\u092a\u094b\u0938\u094d\u0925\u0932\u0940\u0964 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u0939\u0948 \u0915\u093f \u0907\u0928\u0915\u0947 \u0926\u0930\u094d\u0936\u0928 \u092c\u093f\u0928\u093e \u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u092a\u0942\u0930\u094d\u0923 \u0928\u0939\u0940\u0902 \u092e\u093e\u0928\u0940 \u091c\u093e\u0924\u0940\u0964"},{name:"\u091c\u0924\u0940\u092a\u0941\u0930\u093e \u092e\u0941\u0916\u093e\u0930\u0935\u093f\u0902\u0926 (Jatipura)",desc:"\u092e\u0939\u093e\u092a\u094d\u0930\u092d\u0941 \u0935\u0932\u094d\u0932\u092d\u093e\u091a\u093e\u0930\u094d\u092f \u091c\u0940 \u0915\u0940 \u092c\u0948\u0920\u0915 \u090f\u0935\u0902 \u0936\u094d\u0930\u0940\u0928\u093e\u0925 \u091c\u0940 \u0915\u093e \u092a\u094d\u0930\u093e\u0915\u091f\u094d\u092f \u0938\u094d\u0925\u0932\u0964 \u092f\u0939\u093e\u0902 \u092a\u094d\u0930\u0924\u093f\u0926\u093f\u0928 \u0939\u091c\u093e\u0930\u094b\u0902 \u0932\u0940\u091f\u0930 \u0926\u0942\u0927 \u0938\u0947 \u0905\u092d\u093f\u0937\u0947\u0915 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"}]},{name:"\u092d\u093e\u0917 2: \u091b\u094b\u091f\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e (~9 \u0915\u093f\u092e\u0940)",stops:[{name:"\u0930\u093e\u0927\u093e \u0915\u0941\u0902\u0921 \u0935 \u0936\u094d\u092f\u093e\u092e \u0915\u0941\u0902\u0921 (Radha Kund & Shyam Kund)",desc:"\u092c\u094d\u0930\u091c \u092e\u0923\u094d\u0921\u0932 \u0915\u093e \u092a\u0930\u092e \u092a\u093e\u0935\u0928 \u0924\u0940\u0930\u094d\u0925\u0964 \u0905\u0930\u093f\u0937\u094d\u091f\u093e\u0938\u0941\u0930 \u0935\u0927 \u0915\u0947 \u092c\u093e\u0926 \u092d\u0917\u0935\u093e\u0928 \u0928\u0947 \u0936\u094d\u092f\u093e\u092e \u0915\u0941\u0902\u0921 \u0914\u0930 \u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u0928\u0947 \u0905\u092a\u0928\u0940 \u0938\u0916\u093f\u092f\u094b\u0902 \u0938\u0902\u0917 \u0930\u093e\u0927\u093e \u0915\u0941\u0902\u0921 \u092a\u094d\u0930\u0915\u091f \u0915\u093f\u092f\u093e\u0964"},{name:"\u0915\u0941\u0938\u0941\u092e \u0938\u0930\u094b\u0935\u0930 (Kusum Sarovar)",desc:"460 \u092b\u0940\u091f \u0932\u0902\u092c\u093e \u0935\u093f\u0936\u093e\u0932 \u0938\u0930\u094b\u0935\u0930 \u091c\u0939\u093e\u0902 \u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u0905\u092a\u0928\u0940 \u0938\u0916\u093f\u092f\u094b\u0902 \u0938\u0902\u0917 \u092a\u0941\u0937\u094d\u092a \u091a\u0941\u0928\u0928\u0947 \u0906\u0924\u0940 \u0925\u0940\u0902\u0964 \u092f\u0939\u093e\u0902 \u0930\u093e\u091c\u093e \u0938\u0942\u0930\u091c\u092e\u0932 \u0915\u0940 \u091b\u0924\u0930\u093f\u092f\u093e\u0902 \u0935 \u0938\u0941\u0902\u0926\u0930 \u0928\u0915\u094d\u0915\u093e\u0936\u0940 \u0939\u0948\u0964"},{name:"\u092e\u093e\u0928\u0938\u0940 \u0917\u0902\u0917\u093e (Mansi Ganga)",desc:"\u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0915\u0947 \u092e\u0928 \u0915\u0947 \u0938\u0902\u0915\u0932\u094d\u092a \u0938\u0947 \u092a\u094d\u0930\u0915\u091f \u0939\u0941\u0908 \u092a\u093e\u0935\u0928 \u0917\u0902\u0917\u093e\u0964 \u092f\u0939\u093e\u0902 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0917\u0902\u0917\u093e \u0938\u094d\u0928\u093e\u0928 \u0915\u093e \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u092b\u0932 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"},{name:"\u091a\u0915\u094d\u0930\u0947\u0936\u094d\u0935\u0930 \u092e\u0939\u093e\u0926\u0947\u0935 (Chakreshwar Mahadev)",desc:"\u0917\u093f\u0930\u093f\u0930\u093e\u091c \u091c\u0940 \u0915\u0947 \u0930\u0915\u094d\u0937\u0915 \u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0915\u093e \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u092e\u0902\u0926\u093f\u0930\u0964 \u0907\u0902\u0926\u094d\u0930 \u0915\u0947 \u092e\u0942\u0938\u0932\u093e\u0927\u093e\u0930 \u091c\u0932 \u0938\u0947 \u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u0939\u0947\u0924\u0941 \u0938\u0941\u0926\u0930\u094d\u0936\u0928 \u091a\u0915\u094d\u0930 \u092f\u0939\u093e\u0902 \u0938\u094d\u0925\u093f\u0924 \u0925\u093e\u0964"}]}],rules:["\u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0938\u0926\u0948\u0935 \u0926\u0915\u094d\u0937\u093f\u0923\u093e\u0935\u0930\u094d\u0924 (Clockwise) \u0926\u093f\u0936\u093e \u092e\u0947\u0902 \u0915\u0930\u0947\u0902 \u2014 \u0917\u093f\u0930\u093f\u0930\u093e\u091c \u092a\u0930\u094d\u0935\u0924 \u0938\u0926\u0948\u0935 \u0906\u092a\u0915\u0947 \u0926\u093e\u0939\u093f\u0928\u0947 \u0939\u093e\u0925 (Right) \u0915\u0940 \u0913\u0930 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964","\u092a\u0930\u094d\u0935\u0924 \u0915\u0940 \u092a\u093e\u0935\u0928 \u0936\u093f\u0932\u093e\u0913\u0902 \u092a\u0930 \u092a\u0948\u0930 \u0928 \u0930\u0916\u0947\u0902 \u0914\u0930 \u0928 \u0939\u0940 \u0915\u094b\u0908 \u0936\u093f\u0932\u093e \u0909\u0920\u093e \u0915\u0930 \u0918\u0930 \u0932\u0947 \u091c\u093e\u090f\u0902\u0964","\u092e\u093e\u0930\u094d\u0917 \u092e\u0947\u0902 \u0926\u0942\u0927 \u0915\u0940 \u0927\u093e\u0930 \u091a\u0922\u093c\u093e\u0924\u0947 \u0939\u0941\u090f (\u0926\u0941\u0917\u094d\u0927-\u0927\u093e\u0930\u093e) \u0905\u0925\u0935\u093e \u0928\u093f\u0930\u0902\u0924\u0930 '\u0939\u0930\u0947 \u0915\u0943\u0937\u094d\u0923 / \u0930\u093e\u0927\u0947 \u0930\u093e\u0927\u0947' \u092e\u0939\u093e\u092e\u0902\u0924\u094d\u0930 \u091c\u092a\u0924\u0947 \u0939\u0941\u090f \u091a\u0932\u0947\u0902\u0964","\u092f\u0926\u093f \u0926\u0902\u0921\u0935\u0924 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0924\u094b \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0926\u0902\u0921\u0935\u0924 \u092a\u0930 \u0906\u0917\u0947 \u092a\u0924\u094d\u0925\u0930 \u092f\u093e \u0917\u094b\u0932\u093e \u092c\u0928\u093e\u0915\u0930 \u0939\u0940 \u0906\u0917\u0947 \u092c\u0922\u093c\u0947\u0902\u0964"],tips:"\u0917\u094d\u0930\u0940\u0937\u094d\u092e\u0915\u093e\u0932 \u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u0924\u0903 4 \u092c\u091c\u0947 \u092f\u093e \u0938\u0942\u0930\u094d\u092f\u093e\u0938\u094d\u0924 \u092c\u093e\u0926 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964 \u092e\u093e\u0930\u094d\u0917 \u092e\u0947\u0902 \u091c\u0917\u0939-\u091c\u0917\u0939 \u0936\u0941\u0926\u094d\u0927 \u091c\u0932, \u092b\u0932 \u0935 \u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0938\u094d\u0925\u0932 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902\u0964"},{id:"vrindavan",title:"\u0935\u0943\u0928\u094d\u0926\u093e\u0935\u0928 \u092a\u0902\u091a\u0915\u094d\u0930\u094b\u0936\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e",titleEn:"Vrindavan Panchkroshi Parikrama",subtitle:"\u092f\u092e\u0941\u0928\u093e \u0924\u091f \u0935 \u0926\u093f\u0935\u094d\u092f \u0928\u093f\u0915\u0941\u0902\u091c\u094b\u0902 \u0915\u0940 \u092a\u093e\u0935\u0928 11 \u0915\u093f\u092e\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e",distance:"11 - 12 KM",duration:"3 - 4 \u0918\u0902\u091f\u0947",difficulty:"\u0938\u0941\u0917\u092e (Easy to Moderate)",startPoint:"\u0915\u0947\u0936\u0940 \u0918\u093e\u091f / \u0930\u092e\u0923\u0930\u0947\u0924\u0940 \u0907\u0938\u094d\u0915\u0949\u0928",bestTime:"\u092a\u094d\u0930\u093e\u0924\u0903 04:30 AM (\u092e\u0902\u0917\u0932\u093e \u0909\u092a\u0930\u093e\u0902\u0924) \u092f\u093e \u0938\u093e\u092f\u0902 04:30 PM",overview:"\u0935\u0943\u0928\u094d\u0926\u093e\u0935\u0928 \u0927\u093e\u092e \u0915\u0947 \u0915\u0923-\u0915\u0923 \u092e\u0947\u0902 \u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e-\u0915\u0943\u0937\u094d\u0923 \u0915\u0940 \u0928\u093f\u0924\u094d\u092f \u0930\u093e\u0938\u0932\u0940\u0932\u093e \u0935 \u092a\u093e\u0935\u0928 \u0930\u091c \u0935\u093f\u0926\u094d\u092f\u092e\u093e\u0928 \u0939\u0948\u0964 \u092a\u0902\u091a\u0915\u094d\u0930\u094b\u0936\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0935\u0943\u0928\u094d\u0926\u093e\u0935\u0928 \u0915\u0947 \u091a\u093e\u0930\u094b\u0902 \u0913\u0930 \u092f\u092e\u0941\u0928\u093e \u092e\u0939\u093e\u0930\u093e\u0928\u0940 \u0915\u0947 \u092a\u093e\u0935\u0928 \u0924\u091f\u094b\u0902, \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0918\u093e\u091f\u094b\u0902 \u0914\u0930 \u0930\u0938\u093f\u0915 \u0938\u0902\u0924\u094b\u0902 \u0915\u0940 \u0938\u092e\u093e\u0927\u093f\u092f\u094b\u0902 \u0915\u094b \u0938\u094d\u092a\u0930\u094d\u0936 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u090f\u0915\u093e\u0926\u0936\u0940, \u092a\u0942\u0930\u094d\u0923\u093f\u092e\u093e \u0914\u0930 \u0915\u093e\u0930\u094d\u0924\u093f\u0915 \u092e\u093e\u0938 \u092e\u0947\u0902 \u0932\u093e\u0916\u094b\u0902 \u092d\u0915\u094d\u0924 \u092f\u0939 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",sections:[{name:"\u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u092a\u0921\u093c\u093e\u0935 (Major Stops)",stops:[{name:"\u0915\u0947\u0936\u0940 \u0918\u093e\u091f (Keshi Ghat)",desc:"\u092f\u092e\u0941\u0928\u093e \u091c\u0940 \u0915\u093e \u0938\u092c\u0938\u0947 \u0938\u0941\u0902\u0926\u0930 \u0935 \u092a\u094d\u0930\u092e\u0941\u0916 \u0918\u093e\u091f\u0964 \u092d\u0917\u0935\u093e\u0928 \u0928\u0947 \u0915\u0947\u0936\u0940 \u0926\u0948\u0924\u094d\u092f \u0915\u093e \u0935\u0927 \u0915\u0930 \u092f\u0939\u0940\u0902 \u092f\u092e\u0941\u0928\u093e \u091c\u0932 \u092e\u0947\u0902 \u0939\u093e\u0925 \u0927\u094b\u090f \u0925\u0947\u0964 \u0938\u093e\u092f\u0902 \u092e\u0939\u093e\u0906\u0930\u0924\u0940 \u0926\u0930\u094d\u0936\u0928\u0940\u092f \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"},{name:"\u0915\u093e\u0932\u0940\u0926\u0939 (Kaliya Dah)",desc:"\u0915\u093e\u0932\u093f\u092f\u093e \u0928\u093e\u0917 \u0915\u0947 \u0926\u092e\u0928 \u0915\u093e \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0938\u094d\u0925\u0932\u0964 \u092f\u0939\u093e\u0902 \u0935\u0939 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0915\u0926\u0902\u092c \u0935\u0943\u0915\u094d\u0937 \u0906\u091c \u092d\u0940 \u0938\u094d\u0925\u093f\u0924 \u0939\u0948 \u091c\u093f\u0938\u0938\u0947 \u0915\u0942\u0926\u0915\u0930 \u0915\u0928\u094d\u0939\u0948\u092f\u093e \u0928\u0947 \u092f\u092e\u0941\u0928\u093e \u092e\u0947\u0902 \u091b\u0932\u093e\u0902\u0917 \u0932\u0917\u093e\u0908 \u0925\u0940\u0964"},{name:"\u091a\u0940\u0930 \u0918\u093e\u091f (Chir Ghat)",desc:"\u0917\u094b\u092a\u093f\u092f\u094b\u0902 \u0915\u0947 \u0935\u0938\u094d\u0924\u094d\u0930 \u0939\u0930\u0923 \u0935 \u0915\u0926\u0902\u092c \u092a\u0947\u0921\u093c \u0915\u093e \u092a\u093e\u0935\u0928 \u0938\u094d\u0925\u0932\u0964 \u092f\u0939\u093e\u0902 \u092d\u0915\u094d\u0924 \u092e\u0928\u094b\u0915\u093e\u092e\u0928\u093e \u092a\u0942\u0930\u094d\u0924\u093f \u0939\u0947\u0924\u0941 \u0915\u092a\u0921\u093c\u0947 \u0915\u0940 \u091a\u0941\u0928\u0930\u0940 \u092c\u093e\u0902\u0927\u0924\u0947 \u0939\u0948\u0902\u0964"},{name:"\u0907\u092e\u0932\u0940\u0924\u0932\u093e (Imli Tala)",desc:"\u0930\u093e\u0927\u093e \u091c\u0940 \u0915\u0947 \u0935\u093f\u0930\u0939 \u092e\u0947\u0902 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0915\u093e \u0917\u094c\u0930 \u0935\u0930\u094d\u0923 \u0939\u094b\u0928\u0947 \u0915\u093e \u0938\u094d\u0925\u0932 \u090f\u0935\u0902 \u092e\u0939\u093e\u092a\u094d\u0930\u092d\u0941 \u091a\u0948\u0924\u0928\u094d\u092f \u0926\u0947\u0935 \u0915\u0940 \u0927\u094d\u092f\u093e\u0928 \u0938\u094d\u0925\u0932\u0940\u0964"},{name:"\u091c\u094d\u091e\u093e\u0928 \u0917\u0941\u0926\u0921\u093c\u0940 (Gyan Gudri)",desc:"\u0909\u0926\u094d\u0927\u0935 \u091c\u0940 \u0915\u093e \u0905\u0939\u0902\u0915\u093e\u0930 \u0935\u093f\u0917\u0932\u093f\u0924 \u0939\u094b\u0928\u0947 \u0915\u093e \u0938\u094d\u0925\u0932 \u091c\u0939\u093e\u0902 \u0917\u094b\u092a\u093f\u092f\u094b\u0902 \u0915\u0947 \u0928\u093f\u0936\u094d\u091b\u0932 \u092a\u094d\u0930\u0947\u092e \u0915\u0947 \u0906\u0917\u0947 \u091c\u094d\u091e\u093e\u0928 \u092e\u093e\u0930\u094d\u0917 \u0928\u0924\u092e\u0938\u094d\u0924\u0915 \u0939\u094b \u0917\u092f\u093e\u0964"},{name:"\u091f\u091f\u093f\u092f\u093e \u0938\u094d\u0925\u093e\u0928 (Tatiya Sthan)",desc:"\u0938\u094d\u0935\u093e\u092e\u0940 \u0939\u0930\u093f\u0926\u093e\u0938 \u091c\u0940 \u0915\u0940 \u0938\u0902\u0917\u0940\u0924 \u092a\u0930\u0902\u092a\u0930\u093e \u0935 \u0935\u093f\u0930\u0915\u094d\u0924 \u0938\u0902\u0924\u094b\u0902 \u0915\u0940 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0928\u093f\u0915\u0941\u0902\u091c \u0915\u0941\u091f\u093f\u092f\u093e \u091c\u0939\u093e\u0902 \u092c\u093f\u091c\u0932\u0940 \u0914\u0930 \u0906\u0927\u0941\u0928\u093f\u0915 \u0938\u093e\u0927\u0928\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e\u0964"}]}],rules:["\u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0928\u0902\u0917\u0947 \u092a\u0948\u0930 \u0915\u0930\u0928\u0947 \u0915\u093e \u0935\u093f\u0936\u0947\u0937 \u092e\u0939\u093e\u0924\u094d\u092e\u094d\u092f \u0939\u0948\u0964","\u092f\u092e\u0941\u0928\u093e \u091c\u0940 \u0915\u094b \u092a\u094d\u0930\u0923\u093e\u092e \u0915\u0930 \u0935 \u0906\u091a\u092e\u0928 \u0932\u0947\u0915\u0930 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0906\u0930\u0902\u092d \u0915\u0930\u0947\u0902\u0964","\u092c\u0902\u0926\u0930\u094b\u0902 \u0938\u0947 \u091a\u0936\u094d\u092e\u093e, \u092e\u094b\u092c\u093e\u0907\u0932, \u091f\u094b\u092a\u0940 \u0935 \u0916\u093e\u0928\u0947 \u0915\u0940 \u0935\u0938\u094d\u0924\u0941\u090f\u0902 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u091c\u0947\u092c \u092f\u093e \u092c\u0948\u0917 \u092e\u0947\u0902 \u092c\u0902\u0926 \u0930\u0916\u0947\u0902\u0964"],tips:"\u090f\u0915\u093e\u0926\u0936\u0940 \u092a\u0930 \u0905\u0927\u093f\u0915 \u092d\u0940\u0921\u093c \u0930\u0939\u0924\u0940 \u0939\u0948\u0964 \u092a\u094d\u0930\u093e\u0924\u0903 \u092c\u094d\u0930\u0939\u094d\u092e \u092e\u0941\u0939\u0942\u0930\u094d\u0924 \u092e\u0947\u0902 \u091a\u0932\u0928\u0947 \u0938\u0947 \u092f\u092e\u0941\u0928\u093e \u091c\u0940 \u0915\u0940 \u0936\u0940\u0924\u0932 \u0935\u093e\u092f\u0941 \u0914\u0930 \u092a\u0915\u094d\u0937\u093f\u092f\u094b\u0902 \u0915\u093e \u0915\u0932\u0930\u0935 \u0905\u0924\u094d\u092f\u0902\u0924 \u092e\u0928\u092e\u094b\u0939\u0915 \u0932\u0917\u0924\u093e \u0939\u0948\u0964"},{id:"chaurasi_kos",title:"84 \u0915\u094b\u0938 \u092c\u094d\u0930\u091c \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e",titleEn:"Chaurasi Kos Braj Parikrama",subtitle:"84 \u0932\u093e\u0916 \u092f\u094b\u0928\u093f\u092f\u094b\u0902 \u0938\u0947 \u092e\u0941\u0915\u094d\u0924\u093f \u0935 12 \u0935\u0928\u094b\u0902 \u0915\u0940 \u092e\u0939\u093e\u092f\u093e\u0924\u094d\u0930\u093e",distance:"~268 KM (84 \u0915\u094b\u0938)",duration:"21 \u0938\u0947 40 \u0926\u093f\u0928 (\u092a\u0948\u0926\u0932) / 7 \u0938\u0947 10 \u0926\u093f\u0928 (\u0935\u093e\u0939\u0928/\u092c\u0938)",difficulty:"\u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0935 \u092a\u093e\u0935\u0928 (Comprehensive)",startPoint:"\u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f (\u092e\u0925\u0941\u0930\u093e) \u0905\u0925\u0935\u093e \u091a\u094c\u092e\u0941\u0939\u093e\u0902",bestTime:"\u092d\u093e\u0926\u094d\u0930\u092a\u0926, \u0905\u0936\u094d\u0935\u093f\u0928 \u0935 \u0915\u093e\u0930\u094d\u0924\u093f\u0915 \u092e\u093e\u0938 (\u0938\u093f\u0924\u0902\u092c\u0930 \u0938\u0947 \u0928\u0935\u0902\u092c\u0930)",overview:"84 \u0915\u094b\u0938 \u092c\u094d\u0930\u091c \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0938\u092e\u094d\u092a\u0942\u0930\u094d\u0923 \u092c\u094d\u0930\u091c \u092d\u0942\u092e\u093f \u0915\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0935 \u0938\u0930\u094d\u0935\u094b\u092a\u0930\u093f \u092e\u0939\u093e\u092f\u093e\u0924\u094d\u0930\u093e \u0939\u0948\u0964 \u0907\u0938\u092e\u0947\u0902 \u092c\u094d\u0930\u091c \u0915\u0947 12 \u092a\u094d\u0930\u092e\u0941\u0916 \u0935\u0928, 24 \u0909\u092a\u0935\u0928, \u0938\u0948\u0915\u0921\u093c\u094b\u0902 \u092a\u0935\u093f\u0924\u094d\u0930 \u0915\u0941\u0923\u094d\u0921, 4 \u092a\u093e\u0935\u0928 \u092a\u0930\u094d\u0935\u0924 \u0914\u0930 \u092f\u092e\u0941\u0928\u093e \u091c\u0940 \u0915\u0947 \u0926\u094b\u0928\u094b\u0902 \u0924\u091f\u094b\u0902 \u0915\u093e \u0938\u092e\u094d\u092a\u0942\u0930\u094d\u0923 \u092d\u094d\u0930\u092e\u0923 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092f\u0939 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u092e\u0928\u0941\u0937\u094d\u092f \u0915\u094b 84 \u0932\u093e\u0916 \u092f\u094b\u0928\u093f\u092f\u094b\u0902 \u0915\u0947 \u0906\u0935\u093e\u0917\u092e\u0928 \u0938\u0947 \u092e\u0941\u0915\u094d\u0924 \u0915\u0930 \u0915\u0943\u0937\u094d\u0923-\u0932\u094b\u0915 \u0915\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0915\u0930\u093e\u0924\u0940 \u0939\u0948\u0964",sections:[{name:"\u092c\u094d\u0930\u091c \u0915\u0947 12 \u092a\u0935\u093f\u0924\u094d\u0930 \u0935\u0928 (The 12 Sacred Forests)",stops:[{name:"\u092e\u0927\u0941\u0935\u0928 (Madhuvan)",desc:"\u0927\u094d\u0930\u0941\u0935 \u091c\u0940 \u0915\u0940 \u0915\u0920\u094b\u0930 \u0924\u092a\u0938\u094d\u092f\u093e \u0938\u094d\u0925\u0932\u0940 \u090f\u0935\u0902 \u0936\u0924\u094d\u0930\u0941\u0918\u094d\u0928 \u091c\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0932\u0935\u0923\u093e\u0938\u0941\u0930 \u0935\u0927 \u0915\u093e \u0938\u094d\u0925\u093e\u0928\u0964"},{name:"\u0924\u093e\u0932\u0935\u0928 (Talvan)",desc:"\u092c\u0932\u0930\u093e\u092e \u091c\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0927\u0947\u0928\u0941\u0915\u093e\u0938\u0941\u0930 \u0917\u0927\u0947 \u0915\u093e \u0935\u0927 \u0935 \u092e\u0940\u0920\u0947 \u0924\u093e\u0921\u093c \u0915\u0947 \u092b\u0932\u094b\u0902 \u0915\u093e \u0909\u092a\u092d\u094b\u0917\u0964"},{name:"\u0915\u0941\u092e\u0941\u0926\u0935\u0928 \u0935 \u0936\u093e\u0928\u094d\u0924\u0928\u0941 \u0915\u0941\u0923\u094d\u0921",desc:"\u0915\u092e\u0932 \u0915\u0947 \u092a\u0941\u0937\u094d\u092a\u094b\u0902 \u0938\u0947 \u0906\u091a\u094d\u091b\u093e\u0926\u093f\u0924 \u0915\u0941\u092e\u0941\u0926\u0935\u0928 \u090f\u0935\u0902 \u092d\u0940\u0937\u094d\u092e \u092a\u093f\u0924\u093e\u092e\u0939 \u0915\u0947 \u092a\u093f\u0924\u093e \u092e\u0939\u093e\u0930\u093e\u091c \u0936\u093e\u0928\u094d\u0924\u0928\u0941 \u0915\u093e \u0924\u092a \u0938\u094d\u0925\u0932\u0964"},{name:"\u092c\u0939\u0941\u0932\u093e\u0935\u0928 (Bahulavan)",desc:"\u0938\u0924\u094d\u092f\u0935\u093e\u0926\u093f\u0928\u0940 \u092c\u0939\u0941\u0932\u093e \u0917\u093e\u092f \u0914\u0930 \u0938\u093f\u0902\u0939 \u0915\u0940 \u0915\u0925\u093e \u0915\u093e \u0938\u093e\u0915\u094d\u0937\u0940, \u091c\u0939\u093e\u0902 \u0938\u0924\u094d\u092f \u0915\u0940 \u0935\u093f\u091c\u092f \u0939\u0941\u0908\u0964"},{name:"\u0915\u093e\u092e\u0935\u0928 (Kamyavan)",desc:"\u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0915\u0940 \u0915\u093e\u092e\u094d\u092f \u0932\u0940\u0932\u093e\u090f\u0902, \u091a\u094c\u0930\u093e\u0938\u0940 \u0916\u0902\u092d\u093e, \u0935\u093f\u092e\u0932 \u0915\u0941\u0902\u0921 \u0935 \u091a\u0930\u0923 \u092a\u0939\u093e\u0921\u093c\u0940\u0964"},{name:"\u0915\u094b\u0915\u093f\u0932\u093e\u0935\u0928 (Kokilavan)",desc:"\u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u094b\u092f\u0932 \u092c\u0928\u0915\u0930 \u0930\u093e\u0927\u093e \u091c\u0940 \u0915\u094b \u0930\u093f\u091d\u093e\u0928\u0947 \u0915\u093e \u0938\u094d\u0925\u0932 \u0935 \u0938\u093f\u0926\u094d\u0927 \u0936\u0928\u093f\u0926\u0947\u0935 \u092e\u0902\u0926\u093f\u0930\u0964"},{name:"\u092d\u093e\u0902\u0921\u0940\u0930\u0935\u0928 (Bhandirvan)",desc:"\u092c\u094d\u0930\u0939\u094d\u092e\u093e \u091c\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e \u0914\u0930 \u0915\u0943\u0937\u094d\u0923 \u0915\u093e \u0917\u0902\u0927\u0930\u094d\u0935 \u0935\u093f\u0935\u093e\u0939 \u0938\u0902\u092a\u0928\u094d\u0928 \u0915\u0930\u093e\u0928\u0947 \u0915\u093e \u092a\u093e\u0935\u0928 \u0938\u094d\u0925\u0932\u0964"},{name:"\u092e\u0939\u093e\u0935\u0928 (\u0917\u094b\u0915\u0941\u0932)",desc:"\u0928\u0902\u0926\u092c\u093e\u092c\u093e \u0915\u093e \u092e\u0939\u0932, \u092f\u0936\u094b\u0926\u093e \u091c\u0940 \u0915\u0940 \u0917\u094b\u0926 \u092e\u0947\u0902 \u092c\u093e\u0932 \u0915\u0943\u0937\u094d\u0923 \u0915\u0940 \u092c\u093e\u0932 \u0932\u0940\u0932\u093e\u090f\u0902 \u0993 \u092a\u0942\u0924\u0928\u093e \u0909\u0926\u094d\u0927\u093e\u0930\u0964"}]}],rules:["\u0938\u093e\u0924\u094d\u0935\u093f\u0915 \u0906\u0939\u093e\u0930, \u092d\u0942\u092e\u093f \u0936\u092f\u0928 \u0914\u0930 \u092c\u094d\u0930\u0939\u094d\u092e\u091a\u0930\u094d\u092f \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0947\u0902\u0964","\u092e\u093e\u0930\u094d\u0917 \u092e\u0947\u0902 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0938\u0902\u0924\u094b\u0902 \u0935 \u092c\u094d\u0930\u091c\u0935\u093e\u0938\u093f\u092f\u094b\u0902 \u0915\u093e \u0938\u0924\u094d\u0915\u093e\u0930 \u0915\u0930\u0947\u0902\u0964","\u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0926\u0932 \u0915\u0947 \u0938\u093e\u0925 \u091a\u0932\u0928\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0935 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e \u0915\u0940 \u0926\u0943\u0937\u094d\u091f\u093f \u0938\u0947 \u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u092e \u0939\u0948\u0964"],tips:"\u092a\u094d\u0930\u0924\u093f\u0935\u0930\u094d\u0937 \u0915\u093e\u0930\u094d\u0924\u093f\u0915 \u092e\u093e\u0938 \u092e\u0947\u0902 \u0915\u0908 \u0906\u0936\u094d\u0930\u092e \u0935 \u0938\u0902\u0938\u094d\u0925\u093e\u090f\u0902 \u0924\u0902\u092c\u0942, \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e, \u092d\u094b\u091c\u0928 \u0935 \u092c\u0938 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e \u0938\u0939\u093f\u0924 \u0938\u0902\u0917\u0920\u093f\u0924 \u092f\u093e\u0924\u094d\u0930\u093e \u0906\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902\u0964"},{id:"barsana",title:"\u092c\u0930\u0938\u093e\u0928\u093e \u0936\u094d\u0930\u0940\u091c\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e",titleEn:"Barsana Shriji Parikrama",subtitle:"\u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u0915\u0947 \u0928\u093f\u091c \u092e\u0939\u0932 \u0935 \u0932\u0940\u0932\u093e \u0938\u094d\u0925\u0932\u094b\u0902 \u0915\u0940 4 \u0915\u093f\u092e\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e",distance:"4 KM",duration:"1.5 - 2 \u0918\u0902\u091f\u0947",difficulty:"\u0938\u0941\u0917\u092e (Easy)",startPoint:"\u092a\u0940\u0932\u0940 \u092a\u094b\u0916\u0930 (\u092a\u094d\u0930\u093f\u092f\u093e \u0915\u0941\u0902\u0921) / \u0930\u0902\u0917\u0940\u0932\u0940 \u0917\u0932\u0940",bestTime:"\u092a\u094d\u0930\u093e\u0924\u0903 05:30 AM \u092f\u093e \u0938\u093e\u092f\u0902 04:30 PM",overview:"\u092c\u0930\u0938\u093e\u0928\u093e \u0936\u094d\u0930\u0940 \u0935\u0943\u0937\u092d\u093e\u0928\u0941 \u0928\u0902\u0926\u093f\u0928\u0940 \u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u0915\u093e \u092a\u093e\u0935\u0928 \u0927\u093e\u092e \u0939\u0948\u0964 \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0902\u091a\u0932 \u092a\u0930\u094d\u0935\u0924 \u0915\u0947 \u091a\u093e\u0930\u094b\u0902 \u0936\u093f\u0916\u0930\u094b\u0902 \u092a\u0930 \u0938\u094d\u0925\u093f\u0924 \u0936\u094d\u0930\u0940\u091c\u0940 \u092e\u0939\u0932, \u092e\u093e\u0928 \u092e\u0902\u0926\u093f\u0930, \u0935\u093f\u0932\u093e\u0938\u0917\u0922\u093c \u0914\u0930 \u0926\u093e\u0928\u0917\u0922\u093c \u0915\u094b \u0918\u0947\u0930\u0924\u0947 \u0939\u0941\u090f \u092f\u0939 4 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0915\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u092c\u094d\u0930\u091c \u0930\u0938 \u0914\u0930 \u092e\u0927\u0941\u0930 \u092d\u0915\u094d\u0924\u093f \u0915\u093e \u0938\u0930\u094d\u0935\u094b\u091a\u094d\u091a \u0905\u0928\u0941\u092d\u0935 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964",sections:[{name:"\u092a\u094d\u0930\u092e\u0941\u0916 \u092a\u0921\u093c\u093e\u0935 (Key Sacred Stops)",stops:[{name:"\u092a\u0940\u0932\u0940 \u092a\u094b\u0916\u0930 (Pili Pokhar / Priya Kund)",desc:"\u0928\u0902\u0926\u0917\u093e\u0902\u0935 \u0938\u0947 \u0935\u093f\u0935\u093e\u0939 \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0906\u0928\u0947 \u092a\u0930 \u091c\u092c \u092f\u0936\u094b\u0926\u093e \u091c\u0940 \u0928\u0947 \u0930\u093e\u0927\u093e \u091c\u0940 \u0915\u0947 \u0939\u093e\u0925\u094b\u0902 \u092e\u0947\u0902 \u0939\u0932\u094d\u0926\u0940 \u0932\u0917\u093e\u0908, \u0924\u094b \u0939\u093e\u0925 \u0927\u094b\u0928\u0947 \u0938\u0947 \u0907\u0938 \u092a\u094b\u0916\u0930 \u0915\u093e \u091c\u0932 \u092a\u0940\u0932\u093e \u0939\u094b \u0917\u092f\u093e\u0964"},{name:"\u092e\u093e\u0928 \u092e\u0902\u0926\u093f\u0930 (Maan Mandir)",desc:"\u092e\u093e\u0928\u0917\u0922\u093c \u092a\u0930\u094d\u0935\u0924 \u0936\u093f\u0916\u0930 \u092a\u0930 \u0938\u094d\u0925\u093f\u0924 \u0935\u0939 \u0938\u094d\u0925\u0932 \u091c\u0939\u093e\u0902 \u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u0930\u0942\u0920\u0915\u0930 \u092e\u093e\u0928 \u0915\u0930\u0924\u0940 \u0925\u0940\u0902 \u0914\u0930 \u0915\u0943\u0937\u094d\u0923 \u092e\u094b\u0930 \u092c\u0928\u0915\u0930 \u092e\u0928\u093e\u0924\u0947 \u0925\u0947\u0964 \u0930\u092e\u0947\u0936 \u092c\u093e\u092c\u093e \u091c\u0940 \u0915\u093e \u0938\u0947\u0935\u093e \u0906\u0936\u094d\u0930\u092e\u0964"},{name:"\u0938\u093e\u0902\u0915\u0930\u0940 \u0916\u094b\u0930 (Sankari Khor)",desc:"\u0926\u094b \u092a\u0939\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0905\u0924\u093f \u0938\u0902\u0915\u0930\u093e \u092e\u093e\u0930\u094d\u0917 \u091c\u0939\u093e\u0902 \u092c\u093e\u0932 \u0917\u094b\u092a\u093e\u0932 \u0917\u094b\u092a\u093f\u092f\u094b\u0902 \u0915\u093e \u0930\u093e\u0938\u094d\u0924\u093e \u0930\u094b\u0915\u0915\u0930 \u092e\u093e\u0916\u0928-\u0926\u0939\u0940 \u0915\u0940 \u092e\u091f\u0915\u093f\u092f\u094b\u0902 \u0938\u0947 \u0926\u093e\u0928 \u092e\u093e\u0902\u0917\u0924\u0947 \u0925\u0947\u0964"},{name:"\u092e\u094b\u0930 \u0915\u0941\u091f\u0940 (Mor Kuti)",desc:"\u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u0915\u094b \u092a\u094d\u0930\u0938\u0928\u094d\u0928 \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \u091c\u092c \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0928\u0947 \u092e\u092f\u0942\u0930 \u0928\u0943\u0924\u094d\u092f \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u092f\u0939\u093e\u0902 \u092e\u0928\u094b\u0939\u093e\u0930\u0940 \u092e\u092f\u0942\u0930 \u0928\u0943\u0924\u094d\u092f \u091a\u093f\u0924\u094d\u0930 \u0935 \u0915\u0941\u091f\u093f\u092f\u093e \u0939\u0948\u0964"},{name:"\u0926\u093e\u0928\u0917\u0922\u093c \u0935 \u0935\u093f\u0932\u093e\u0938\u0917\u0922\u093c",desc:"\u092a\u094d\u0930\u0947\u092e \u0926\u093e\u0928 \u0935 \u0939\u093e\u0938-\u092a\u0930\u093f\u0939\u093e\u0938 \u0915\u0940 \u092e\u0927\u0941\u0930 \u0932\u0940\u0932\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0915\u094d\u0937\u0940 \u092a\u0930\u094d\u0935\u0924 \u0936\u093f\u0916\u0930\u0964"}]}],rules:["\u092c\u0930\u0938\u093e\u0928\u093e \u092e\u0947\u0902 \u0915\u0947\u0935\u0932 '\u0930\u093e\u0927\u0947-\u0930\u093e\u0927\u0947' \u0915\u093e \u0928\u093e\u092e \u0932\u0947\u0902\u0964","\u0938\u093e\u0902\u0915\u0930\u0940 \u0916\u094b\u0930 \u0915\u0940 \u091a\u0922\u093c\u093e\u0908 \u092a\u0930 \u0938\u0902\u092d\u0932\u0915\u0930 \u091a\u0932\u0947\u0902\u0964","\u092e\u094b\u0930 \u0915\u0941\u091f\u0940 \u0935 \u092e\u093e\u0928 \u092e\u0902\u0926\u093f\u0930 \u0915\u0947 \u0926\u0930\u094d\u0936\u0928 \u0905\u0935\u0936\u094d\u092f \u0915\u0930\u0947\u0902\u0964"],tips:"\u0930\u093e\u0927\u093e\u0937\u094d\u091f\u092e\u0940 \u0935 \u0932\u091f\u094d\u0920\u092e\u093e\u0930 \u0939\u094b\u0932\u0940 \u092a\u0930 \u092f\u0939\u093e\u0902 \u0932\u093e\u0916\u094b\u0902 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0940\u0922\u093c\u093f\u092f\u094b\u0902 \u0915\u0947 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0905\u092c \u0930\u094b\u092a\u0935\u0947 (Ropeway) \u092d\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964"},{id:"mathura",title:"\u092e\u0925\u0941\u0930\u093e \u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f \u092a\u0902\u091a\u0915\u094d\u0930\u094b\u0936\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e",titleEn:"Mathura Panchkroshi Parikrama",subtitle:"\u092f\u092e\u0941\u0928\u093e \u092e\u0939\u093e\u0930\u093e\u0928\u0940 \u0935 \u091a\u093e\u0930 \u0926\u093f\u0915\u094d\u092a\u093e\u0932 \u0936\u093f\u0935 \u092e\u0902\u0926\u093f\u0930\u094b\u0902 \u0915\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e",distance:"~10 KM",duration:"2.5 - 3.5 \u0918\u0902\u091f\u0947",difficulty:"\u0938\u0941\u0917\u092e (Easy to Moderate)",startPoint:"\u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f (\u092f\u092e\u0941\u0928\u093e \u0924\u091f)",bestTime:"\u092a\u094d\u0930\u093e\u0924\u0903 05:00 AM \u092f\u093e \u0938\u093e\u092f\u0902 05:00 PM",overview:"\u0915\u0902\u0938 \u0915\u0947 \u0935\u0927 \u0915\u0947 \u0909\u092a\u0930\u093e\u0902\u0924 \u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0914\u0930 \u092c\u0932\u0930\u093e\u092e \u091c\u0940 \u0928\u0947 \u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f \u092a\u0930 \u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u092e\u0925\u0941\u0930\u093e \u0915\u0940 \u092a\u0902\u091a\u0915\u094d\u0930\u094b\u0936\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f \u0938\u0947 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0939\u094b\u0915\u0930 \u092f\u092e\u0941\u0928\u093e \u0915\u0947 \u0924\u091f\u0935\u0930\u094d\u0924\u0940 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u091f\u0940\u0932\u094b\u0902 \u0914\u0930 \u092e\u0925\u0941\u0930\u093e \u0928\u0917\u0930 \u0915\u0947 \u091a\u093e\u0930\u094b\u0902 \u0926\u093f\u0936\u093e\u0913\u0902 \u0915\u0947 \u0930\u0915\u094d\u0937\u0915 \u092e\u0939\u093e\u0926\u0947\u0935 (\u092d\u0942\u0924\u0947\u0936\u094d\u0935\u0930, \u0930\u0902\u0917\u0947\u0936\u094d\u0935\u0930, \u0917\u094b\u0915\u0930\u094d\u0923\u0947\u0936\u094d\u0935\u0930, \u092a\u093f\u092a\u0932\u0947\u0936\u094d\u0935\u0930) \u0915\u094b \u0928\u092e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",sections:[{name:"\u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u0947 \u092e\u0941\u0916\u094d\u092f \u0926\u0930\u094d\u0936\u0928 (Main Darshan Points)",stops:[{name:"\u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f (Vishram Ghat)",desc:"\u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u093e \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0935 \u0938\u092e\u093e\u092a\u0928 \u0915\u0947\u0902\u0926\u094d\u0930\u0964 \u092f\u0939\u093e\u0902 \u092f\u092e\u0941\u0928\u093e \u0938\u094d\u0928\u093e\u0928, \u0938\u0902\u0915\u0932\u094d\u092a \u0935 \u0938\u093e\u092f\u0902\u0915\u093e\u0932\u0940\u0928 \u092e\u0939\u093e\u0906\u0930\u0924\u0940 \u0915\u093e \u0935\u093f\u0936\u0947\u0937 \u092e\u0939\u093e\u0924\u094d\u092e\u094d\u092f \u0939\u0948\u0964"},{name:"\u0915\u0902\u0938 \u091f\u0940\u0932\u093e (Kansa Tila)",desc:"\u0935\u0939 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u091f\u0940\u0932\u093e \u091c\u0939\u093e\u0902 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0928\u0947 \u092a\u093e\u092a\u0940 \u0915\u0902\u0938 \u0915\u093e \u0935\u0927 \u0915\u0930 \u0909\u0917\u094d\u0930\u0938\u0947\u0928 \u091c\u0940 \u0915\u094b \u092a\u0941\u0928\u0903 \u092e\u0925\u0941\u0930\u093e \u0915\u093e \u0930\u093e\u091c\u094d\u092f \u0938\u094c\u0902\u092a\u093e\u0964"},{name:"\u092d\u0942\u0924\u0947\u0936\u094d\u0935\u0930 \u092e\u0939\u093e\u0926\u0947\u0935 (Bhuteshwar Mahadev)",desc:"\u092e\u0925\u0941\u0930\u093e \u0915\u0947 \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0926\u093f\u0915\u094d\u092a\u093e\u0932 \u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935\u0964 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u0939\u0948 \u0915\u093f \u0907\u0928\u0915\u0947 \u0926\u0930\u094d\u0936\u0928 \u0915\u0947 \u092c\u093f\u0928\u093e \u092e\u0925\u0941\u0930\u093e \u0935\u093e\u0938 \u0915\u093e \u092b\u0932 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e\u0964"},{name:"\u0930\u0902\u0917\u0947\u0936\u094d\u0935\u0930 \u092e\u0939\u093e\u0926\u0947\u0935 (Rangeshwar Mahadev)",desc:"\u0915\u0902\u0938 \u0915\u0940 \u0930\u0902\u0917\u0936\u093e\u0932\u093e \u0915\u0947 \u092a\u093e\u0938 \u0938\u094d\u0925\u093f\u0924 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0936\u093f\u0935 \u092e\u0902\u0926\u093f\u0930 \u091c\u0939\u093e\u0902 \u092e\u0932\u094d\u0932 \u092f\u0941\u0926\u094d\u0927 \u0938\u0947 \u092a\u0942\u0930\u094d\u0935 \u092d\u0917\u0935\u093e\u0928 \u0928\u0947 \u0936\u093f\u0935 \u0935\u0902\u0926\u0928\u093e \u0915\u0940 \u0925\u0940\u0964"},{name:"\u0926\u094d\u0935\u093e\u0930\u093f\u0915\u093e\u0927\u0940\u0936 \u092e\u0902\u0926\u093f\u0930 \u0935 \u0938\u094d\u0935\u093e\u092e\u0940 \u0918\u093e\u091f",desc:"\u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f \u0915\u0947 \u0938\u092e\u0940\u092a \u092a\u0941\u0937\u094d\u091f\u093f\u092e\u093e\u0930\u094d\u0917\u0940\u092f \u0935\u0948\u092d\u0935\u0936\u093e\u0932\u0940 \u092e\u0902\u0926\u093f\u0930 \u091c\u0939\u093e\u0902 \u0930\u093e\u091c\u094d\u092f\u093e\u0927\u093f\u0930\u093e\u091c \u0930\u0942\u092a \u092e\u0947\u0902 \u092d\u0917\u0935\u093e\u0928 \u0935\u093f\u0930\u093e\u091c\u0924\u0947 \u0939\u0948\u0902\u0964"}]}],rules:["\u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f \u092a\u0930 \u092f\u092e\u0941\u0928\u093e \u091c\u0940 \u0915\u094b \u0926\u0940\u092a\u0926\u093e\u0928 \u0935 \u092a\u094d\u0930\u0923\u093e\u092e \u0915\u0930 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u093e \u0938\u0902\u0915\u0932\u094d\u092a \u0932\u0947\u0902\u0964","\u090f\u0915\u093e\u0926\u0936\u0940, \u0926\u0947\u0935\u0909\u0920\u0928\u0940 \u090f\u0915\u093e\u0926\u0936\u0940 \u0935 \u0905\u0915\u094d\u0937\u092f \u0928\u0935\u092e\u0940 \u092a\u0930 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0915\u093e \u0938\u0939\u0938\u094d\u0924\u094d\u0930 \u0917\u0941\u0928\u093e \u092b\u0932 \u092c\u0924\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964"],tips:"\u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u092e\u093e\u0930\u094d\u0917 \u092a\u0930 \u0908-\u0930\u093f\u0915\u094d\u0936\u093e \u092d\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0930\u0939\u0924\u093e \u0939\u0948\u0964 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0909\u092a\u0930\u093e\u0902\u0924 \u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f \u092a\u0930 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u092e\u0925\u0941\u0930\u093e \u0915\u0947 \u092a\u0947\u0921\u093c\u0947 \u0915\u093e \u092d\u094b\u0917 \u0932\u0917\u093e\u090f\u0902\u0964"}]},838);
