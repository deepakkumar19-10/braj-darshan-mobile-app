0943\u0902\u0926\u093e\u0935\u0928, \u0917\u094b\u0935\u0930\u094d\u0927\u0928, \u092c\u0930\u0938\u093e\u0928\u093e, \u0917\u094b\u0915\u0941\u0932 \u0914\u0930 \u0928\u0902\u0926\u0917\u093e\u0902\u0935 \u2014 \u091c\u0939\u093e\u0901 \u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0914\u0930 \u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u0915\u0940 \u0905\u0932\u094c\u0915\u093f\u0915 \u0932\u0940\u0932\u093e\u090f\u0902 \u0906\u091c \u092d\u0940 \u0915\u0923-\u0915\u0923 \u092e\u0947\u0902 \u0935\u093f\u0926\u094d\u092f\u092e\u093e\u0928 \u0939\u0948\u0902\u0964 \u092c\u094d\u0930\u091c \u0926\u0930\u094d\u0936\u0928 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0905\u092a\u0928\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u094b \u0938\u0941\u0917\u092e, \u092e\u0902\u0917\u0932\u092e\u092f \u0914\u0930 \u092d\u0915\u094d\u0924\u093f\u092e\u092f \u092c\u0928\u093e\u090f\u0902\u0964",featuredTitle:"\u092a\u094d\u0930\u092e\u0941\u0916 \u0926\u0930\u094d\u0936\u0928\u0940\u092f \u092e\u0902\u0926\u093f\u0930",featuredSub:"\u0926\u0930\u094d\u0936\u0928, \u0906\u0930\u0924\u0940 \u0938\u092e\u092f \u0914\u0930 \u092a\u093e\u0935\u0928 \u0907\u0924\u093f\u0939\u093e\u0938",viewAllTemples:"\u0938\u092d\u0940 \u092e\u0902\u0926\u093f\u0930 \u0926\u0930\u094d\u0936\u0928 \u0926\u0947\u0916\u0947\u0902 \u2192",reviewsTitle:"\u092d\u0915\u094d\u0924\u094b\u0902 \u0915\u0947 \u092a\u093e\u0935\u0928 \u0905\u0928\u0941\u092d\u0935",reviewsSub:"\u0924\u0940\u0930\u094d\u0925 \u092f\u093e\u0924\u094d\u0930\u093f\u092f\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u093e\u091d\u093e \u0915\u093f\u090f \u0917\u090f \u0905\u0935\u093f\u0938\u094d\u092e\u0930\u0923\u0940\u092f \u0905\u0928\u0941\u092d\u0935"},temples:{heroTag:"\ud83d\uded5 \u0936\u094d\u0930\u0940 \u092a\u093e\u0935\u0928 \u0926\u0930\u094d\u0936\u0928",heroTitle:"\u092c\u094d\u0930\u091c \u0915\u0947 \u092a\u