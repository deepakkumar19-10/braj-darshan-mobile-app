u091d\u0932\u0915\u093e\u0924\u093e, \u0928\u0902\u0926 \u0915\u0947 \u0906\u0928\u0902\u0926 \u0928\u0902\u0926\u0932\u093e\u0932\u093e\u0964","\u0917\u0917\u0928 \u0938\u092e \u0905\u0902\u0917 \u0915\u093e\u0902\u0924\u093f \u0915\u093e\u0930\u0940, \u0930\u093e\u0927\u093f\u0915\u093e \u0930\u092e\u0928 \u092c\u093f\u0939\u093e\u0930\u0940 \u0915\u0940 \u0965","\u0906\u0930\u0924\u0940 \u0915\u0941\u0902\u091c\u092c\u093f\u0939\u093e\u0930\u0940 \u0915\u0940, \u0936\u094d\u0930\u0940 \u0917\u093f\u0930\u093f\u0927\u0930 \u0915\u0943\u0937\u094d\u0923 \u092e\u0941\u0930\u093e\u0930\u0940 \u0915\u0940 \u0965","\u0915\u0928\u0915\u092e\u092f \u092e\u0941\u0915\u0941\u091f \u092c\u093f\u0932\u0938\u093f \u0930\u0939\u094d\u092f\u094b, \u091a\u093f\u0924\u094d\u0924 \u0939\u0930\u093f \u0932\u0947\u0924 \u092e\u0902\u0926 \u092e\u0941\u0938\u0941\u0915\u093e\u092f\u094b\u0964","\u091a\u0930\u0923\u0928 \u0928\u0942\u092a\u0941\u0930 \u0930\u0941\u0928\u091d\u0941\u0928 \u092c\u093e\u091c\u0947, \u0926\u0947\u0916 \u091b\u0935\u093f \u0924\u094d\u0930\u093f\u092d\u0941\u0935\u0928 \u092e\u0928 \u0932\u093e\u091c\u0947\u0964","\u091c\u0939\u093e\u0901 \u0924\u0947 \u092a\u094d\u0930\u0917\u091f \u092d\u0908 \u0917\u0902\u0917\u093e, \u0915\u0932\u0941\u0937 \u0915\u0932\u093f\u0939\u093e\u0930\u093f\u0923\u0940 \u0936\u094d\u0930\u0940 \u0917\u0902\u0917\u093e\u0964","\u0938\u094d\u092e\u0930\u0923 \u0924\u0947 \u0939\u094b\u0924 \u092d\u0935 \u092d\u0902\u0917\u093e, \u091a\u0930\u0923 \u091b\u0935\u093f \u0936\u094d\u0930\u0940 \u092c\u0928\u0935\u093e\u0930\u0940 \u0915\u0940 \u0965","\u0906\u0930\u0924\u0940 \u0915\u0941\u0902\u091c\u092c\u093f\u0939\u093e\u0930\u0940 \u0915\u0940, \u0936\u094d\u0930\u0940 \u0917\u093f\u0930\u093f\u0927\u0930 \u0915\u0943\u0937\u094d\u0923 \u092e\u0941\u0930\u093e\u0930\u0940 \u0915\u0940 \u0965","\u0915\u0928\u0915 \u0938\u093f\u0902\u0939\u093e\u0938\u0928 \u0905\u0924\u093f \u0938\u094b\u0939\u0948, \u0930\u0942\u092a \u0932\u0916\u093f \u091a\u0939\u0941\u0902\u0926\u093f\u0936\u093f \u092e\u0928 \u092e\u094b\u0939\u0948\u0964","\u0926\u0940\u092a\u0915 \u091c\u094d\u092f\u094b\u0924\u093f \u092a\u094d\u0930\u0915\u093e\u0936\u0924\u093f \u092d\u093e\u0930\u0940, \u0906\u0930\u0924\u0940 \u0915\u0930\u0924 \u0938\u0915\u0932 \u0928\u0930 \u0928\u093e\u0930\u0940\u0964","\u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e\u0935\u0930 \u0915\u0941\u0902\u091c\u092c\u093f\u0939\u093e\u0930\u0940 \u0915\u0940, \u0906\u0930\u0924\u0940 \u0936\u094d\u0930\u0940 \u0917\u093f\u0930\u093f\u0927\u0930 \u092e\u0941\u0930\u093e\u0930\u0940 \u0915\u0940 \u0965"]},{id:"yamunashtakam",titleHindi:"\u0936\u094d\u0930\u0940 \u092f\u092e\u0941\u0928\u093e\u0937\u094d\u091f\u0915\u092e\u094d \u0938\u094d\u0924\u094b\u0924\u094d\u0930",titleEn:"Shri Yamunashtakam Stotram",deity:"\u0936\u094d\u0930\u0940 \u092f\u092e\u0941\u0928\u093e \u092e\u0939\u093e\u0930\u093e\u0928\u0940",temple:"\u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0918\u093e\u091f, \u092e\u0925\u0941\u0930\u093e \u0935 \u0915\u0947\u0936\u0940 \u0918\u093e\u091f, \u0935\u0943\u0902\u0926\u093e\u0935\u0928",durationDisplay:"5:30",approxSeconds:330,audioUrl:"https://ia800301.us.archive.org/15/items/ShreeKrishnaBhajan/Yamunashtakam.mp3",significance:"\u091c\u0917\u0926\u094d\u0917\u0941\u0930\u0941 \u0936\u094d\u0930\u0940\u092e\u0926\u094d \u0935\u0932\u094d\u0932\u092d\u093e\u091a\u093e\u0930\u094d\u092f \u092e\u0939\u093e\u092a\u094d\u0930\u092d\u0941 \u0926\u094d\u0935\u093e\u0930\u093e \u0930\u091a\u093f\u0924 \u0926\u093f\u0935\u094d\u092f \u0905\u0937\u094d\u091f\u0915\u0964 \u0936\u094d\u0930\u0940 \u092f\u092e\u0941\u0928\u093e \u091c\u0940 \u0915\u0947 \u0928\u093f\u0924\u094d\u092f \u0938\u094d\u092e\u0930\u0923 \u0935 \u092a\u093e\u0920 \u0938\u0947 \u092d\u0917\u0935\u093e\u0928 \u0936\u094d\u0930\u0940\u0915\u0943\u0937\u094d\u0923 \u0915\u0947 \u091a\u0930\u0923\u094b\u0902 \u092e\u0947\u0902 \u0905\u0928\u0928\u094d\u092f \u092a\u094d\u0930\u0940\u0924\u093f \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",lyrics:["\u0928\u092e\u093e\u092e\u093f \u092f\u092e\u0941\u0928\u093e\u092e\u0939\u0902 \u0938\u0915\u0932 \u0938\u093f\u0926\u094d\u0927\u093f \u0939\u0947\u0924\u0941\u0902 \u092e\u0941\u0926\u093e,","\u092e\u0941\u0930\u093e\u0930\u093f \u092a\u0926\u092a\u0902\u0915\u091c \u0938\u094d\u092b\u0941\u0930\u0926\u092e\u0928\u094d\u0926 \u0930\u0947\u0923\u0941\u0924\u094d\u0915\u091f\u093e\u092e\u094d\u0964","\u0924\u091f\u0938\u094d\u0925 \u0928\u0935 \u0915\u093e\u0928\u0928 \u092a\u094d\u0930\u0915\u091f \u092e\u094b\u0926 \u092a\u0941\u0937\u094d\u092a\u093e\u092e\u094d\u092c\u0941\u0928\u093e,","\u0938\u0941\u0930\u093e\u0938\u0941\u0930 \u0938\u0941\u0935\u0928\u094d\u0926\u093f\u0924\u093e \u0938\u094d\u092e\u0930 \u092a\u093f\u0924\u0941\u0903 \u0936\u094d\u0930\u093f\u092f\u0902 \u092c\u093f\u092d\u094d\u0930\u0924\u0940\u092e\u094d \u0965 \u0967 \u0965","\u0915\u0932\u093f\u0928\u094d\u0926 \u0917\u093f\u0930\u093f \u092e\u0928\u094d\u0926\u093f\u0930\u0947 \u092a\u0924\u0926\u092e\u0928\u094d\u0926 \u092e\u0928\u094d\u0926\u094b\u0926\u094d\u0917\u0924\u093e,","\u0935\u093f\u0932\u094b\u0915\u094d\u092f \u0930\u0924\u093f \u0932\u092e\u094d\u092a\u091f\u0902 \u092d\u0941\u0935\u0928 \u092e\u0923\u094d\u0921\u0932\u0902 \u092d\u0942\u0937\u093f\u0924\u093e\u092e\u094d\u0964","\u0924\u0930\u0902\u0917 \u092d\u0941\u091c \u0935\u0932\u094d\u0932\u0930\u0940 \u0936\u092e\u093f\u0924 \u092a\u093e\u092a \u0938\u0928\u094d\u0926\u094b\u0939\u0928\u093e\u0902,","\u092a\u094d\u0930\u092e\u094b\u0926 \u092d\u0930 \u092a\u0942\u0930\u093f\u0924\u093e\u0902 \u092a\u094d\u0930\u0923\u092e\u0924 \u0936\u094d\u0930\u0940\u092f\u092e\u0941\u0928\u093e\u0902 \u092e\u0941\u0926\u093e \u0965 \u0968 \u0965","\u0935\u093f\u0936\u0941\u0926\u094d\u0927 \u092e\u0925\u0941\u0930\u093e \u0924\u091f\u0947 \u092e\u0941\u0915\u0941\u091f \u092d\u093e\u0938\u092e\u093e\u0928\u093e\u0902 \u092a\u0930\u093e\u0902,","\u0935\u093f\u0939\u093e\u0930 \u091c\u0932 \u092e\u0928\u094d\u0926\u093f\u0930\u0947 \u0935\u093f\u092e\u0932 \u0915\u093e\u0928\u094d\u0924\u093f \u0932\u094b\u0932\u093e\u0930\u0941\u0923\u093e\u0902\u0964","\u0938\u092e\u0938\u094d\u0924 \u0926\u0941\u0930\u093f\u0924 \u0915\u094d\u0937\u092f\u0902 \u0935\u093f\u092e\u0932 \u092d\u0915\u094d\u0924\u093f \u0938\u0902\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f\u0926\u093e\u0902,","\u0928\u092e\u093e\u092e\u093f \u092e\u0941\u0926 \u0927\u093e\u0930\u093f\u0923\u0940\u0902 \u0936\u0930\u0923\u092e\u093e\u0936\u094d\u0930\u092f\u0947 \u0936\u094d\u0930\u0940\u092f\u092e\u0941\u0928\u093e\u092e\u094d \u0965 \u0969 \u0965"]},{id:"radha_kripa_kataksha",titleHindi:"\u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e \u0915\u0943\u092a\u093e \u0915\u091f\u093e\u0915\u094d\u0937 \u0938\u094d\u0924\u094b\u0924\u094d\u0930",titleEn:"Shri Radha Kripa Kataksha Stotram",deity:"\u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940",temple:"\u0930\u093e\u0927\u093e \u0930\u093e\u0928\u0940 \u092e\u0902\u0926\u093f\u0930 (\u0936\u094d\u0930\u0940\u091c\u0940), \u092c\u0930\u0938\u093e\u0928\u093e",durationDisplay:"6:10",approxSeconds:370,audioUrl:"https://ia800301.us.archive.org/15/items/ShreeKrishnaBhajan/RadhaKripaKataksha.mp3",significance:"\u0938\u094d\u0915\u0928\u094d\u0926 \u092a\u0941\u0930\u093e\u0923\u094b\u0915\u094d\u0924 \u0909\u092e\u093e-\u092e\u0939\u0947\u0936\u094d\u0935\u0930 \u0938\u0902\u0935\u093e\u0926 \u0938\u0947 \u0909\u0926\u094d\u0927\u0943\u0924 \u0905\u0924\u093f \u092a\u093e\u0935\u0928 \u0938\u094d\u0924\u094b\u0924\u094d\u0930\u0964 \u0907\u0938\u0915\u0947 \u0928\u093f\u0924\u094d\u092f \u0917\u093e\u0928 \u0938\u0947 \u0936\u094d\u0930\u0940 \u0915\u093f\u0936\u094b\u0930\u0940 \u091c\u0940 \u0915\u0940 \u092a\u0930\u092e \u0915\u0943\u092a\u093e \u0935 \u0915\u0943\u092a\u093e \u0915\u091f\u093e\u0915\u094d\u0937 \u0915\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",lyrics:["\u092e\u0941\u0928\u0940\u0928\u094d\u0926\u094d\u0930\u0935\u0943\u0928\u094d\u0926\u0935\u0928\u094d\u0926\u093f\u0924\u0947 \u0924\u094d\u0930\u093f\u0932\u094b\u0915\u0936\u094b\u0915\u0939\u093e\u0930\u093f\u0923\u0940,","\u092a\u094d\u0930\u0938\u0928\u094d\u0928\u0935\u0915\u094d\u0924\u094d\u0930\u092a\u0919\u094d\u0915\u091c\u0947 \u0928\u093f\u0915\u0941\u091e\u094d\u091c\u092d\u0942\u0935\u093f\u0932\u093e\u0938\u093f\u0928\u0940\u0964","\u0935\u094d\u0930\u091c\u0947\u0928\u094d\u0926\u094d\u0930\u092d\u093e\u0928\u0941 \u0928\u0928\u094d\u0926\u093f\u0928\u0940 \u092a\u094d\u0930\u092b\u0941\u0932\u094d\u0932 \u092e\u0932\u094d\u0932\u093f\u0915\u093e \u0932\u0924\u0947,","\u0915\u0926\u093e \u0915\u0930\u093f\u0937\u094d\u092f\u0938\u0940\u0939 \u092e\u093e\u0902 \u0915\u0943\u092a\u093e\u0915\u091f\u093e\u0915\u094d\u0937\u092d\u093e\u091c\u0928\u092e\u094d \u0965 \u0967 \u0965","\u0905\u0936\u094b\u0915\u0935\u0943\u0915\u094d\u0937\u0935\u0932\u094d\u0932\u0930\u0940 \u0935\u093f\u0924\u093e\u0928\u092e\u0923\u094d\u0921\u092a\u0938\u094d\u0925\u093f\u0924\u0947,","\u092a\u094d\u0930\u0935\u093e\u0932\u0939\u0947\u092e\u092a\u0932\u094d\u0932\u0935 \u092a\u094d\u0930\u092d\u093e\u0932\u0941\u0923\u093e\u0919\u094d\u0918\u094d\u0930\u093f\u0915\u094b\u092e\u0932\u0947\u0964","\u0935\u0930\u093e\u092d\u092f\u0938\u094d\u092b\u0941\u0930\u0924\u094d\u0915\u0930\u0947 \u092a\u094d\u0930\u092d\u0942\u0924\u0938\u092e\u094d\u092a\u0926\u093e\u0932\u092f\u0947,","\u0915\u0926\u093e \u0915\u0930\u093f\u0937\u094d\u092f\u0938\u0940\u0939 \u092e\u093e\u0902 \u0915\u0943\u092a\u093e\u0915\u091f\u093e\u0915\u094d\u0937\u092d\u093e\u091c\u0928\u092e\u094d \u0965 \u0968 \u0965","\u0905\u0928\u0919\u094d\u0917\u0930\u093e\u0917\u0926\u0940\u092a\u0915 \u092a\u094d\u0930\u0938\u0942\u0928\u0936\u0938\u094d\u0924\u094d\u0930\u0938\u0902\u0938\u094d\u0924\u0941\u0924\u0947,","\u0938\u092e\u0938\u094d\u0924\u0932\u094b\u0915\u0935\u0928\u094d\u0926\u093f\u0924\u0947 \u0915\u0943\u092a\u093e\u0915\u091f\u093e\u0915\u094d\u0937\u0935\u0940\u0915\u094d\u0937\u093f\u0924\u0947\u0964","\u092e\u0939\u0947\u0928\u094d\u0926\u094d\u0930\u0928\u0928\u094d\u0926\u093f\u0928\u0940\u0935\u0943\u0924\u0947 \u092e\u0928\u094b\u0939\u0930\u092a\u094d\u0930\u0938\u093e\u0926\u093f\u0928\u0940,","\u0915\u0926\u093e \u0915\u0930\u093f\u0937\u094d\u092f\u0938\u0940\u0939 \u092e\u093e\u0902 \u0915\u0943\u092a\u093e\u0915\u091f\u093e\u0915\u094d\u0937\u092d\u093e\u091c\u0928\u092e\u094d \u0965 \u0969 \u0965"]},{id:"govind_hare_murari",titleHindi:"\u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0917\u094b\u0935\u093f\u0902\u0926 \u0939\u0930\u0947 \u092e\u0941\u0930\u093e\u0930\u0940",titleEn:"Shri Krishna Govind Hare Murari",deity:"\u0936\u094d\u0930\u0940 \u0930\u093e\u0927\u093e \u0915\u0943\u0937\u094d\u0923",temple:"\u0930\u092e\u0923 \u0930\u0947\u0924\u0940 \u0935 \u0917\u094b\u0915\u0941\u0932 \u0927\u093e\u092e",durationDisplay:"4:45",approxSeconds:285,audioUrl:"https://ia800301.us.archive.org/15/items/ShreeKrishnaBhajan/KrishnaGovindHareMurari.mp3",significance:"\u092a\u0930\u092e \u0936\u093e\u0902\u0924 \u0935 \u0915\u0930\u0941\u0923\u093e\u092e\u092f\u0940 \u092d\u0917\u0935\u0928\u094d\u0928\u093e\u092e \u0938\u0902\u0915\u0940\u0930\u094d\u0924\u0928\u0964 \u092e\u0928 \u0915\u0940 \u0935\u094d\u092f\u0917\u094d\u0930\u0924\u093e \u0915\u094b \u0936\u093e\u0902\u0924 \u0915\u0930 \u092c\u094d\u0930\u091c \u0930\u091c \u0915\u093e \u0905\u0932\u094c\u0915\u093f\u0915 \u0905\u0928\u0941\u092d\u0935 \u0915\u0930\u093e\u0924\u093e \u0939\u0948\u0964",lyrics:["\u0936\u094d\u0930\u0940 \u0915\u0943\u0937\u094d\u0923 \u0917\u094b\u0935\u093f\u0902\u0926 \u0939\u0930\u0947 \u092e\u0941\u0930\u093e\u0930\u0940, \u0939\u0947 \u0928\u093e\u0925 \u0928\u093e\u0930\u093e\u092f\u0923 \u0935\u093e\u0938\u0941\u0926\u0947\u0935\u093e \u0965","\u092a\u093f\u0924\u0941 \u092e\u093e\u0924\u0941 \u0938\u094d\u0935\u093e\u092e\u0940 \u0938\u0916\u093e \u0939\u092e\u093e\u0930\u0947, \u0939\u0947 \u0928\u093e\u0925 \u0928\u093e\u0930\u093e\u092f\u0923 \u0935\u093e\u0938\u0941\u0926\u0947\u0935\u093e \u0965","\u0917\u094b\u0935\u093f\u0928\u094d\u0926 \u092e\u0947\u0930\u094b \u0939\u0948, \u0917\u094b\u092a\u093e\u0932 \u092e\u0947\u0930\u094b \u0939\u0948\u0964","\u0936\u094d\u0930\u0940 \u092c\u093e\u0901\u0915\u0947\u092c\u093f\u0939\u093e\u0930\u0940 \u0928\u0902\u0926\u0932\u093e\u0932 \u092e\u0947\u0930\u094b \u0939\u0948 \u0965","\u0930\u093e\u0927\u0947 \u0930\u093e\u0927\u0947 \u091c\u092a\u094b \u091a\u0932\u0947 \u0906\u090f\u0902\u0917\u0947 \u092c\u093f\u0939\u093e\u0930\u0940,","\u0906\u090f\u0902\u0917\u0947 \u092c\u093f\u0939\u093e\u0930\u0940 \u091a\u0932\u0947 \u0906\u090f\u0902\u0917\u0947 \u092c\u093f\u0939\u093e\u0930\u0940 \u0965"]},{id:"govardhan_aarti",titleHindi:"\u0936\u094d\u0930\u0940 \u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092e\u0939\u093e\u0930\u093e\u091c \u0915\u0940 \u0906\u0930\u0924\u0940",titleEn:"Shri Govardhan Maharaj Aarti",deity:"\u0917\u093f\u0930\u093f\u0930\u093e\u091c \u0927\u0930\u0923 (\u0936\u094d\u0930\u0940 \u0917\u094b\u0935\u0930\u094d\u0927\u0928)",temple:"\u0926\u093e\u0928\u0918\u093e\u091f\u0940 \u092e\u0902\u0926\u093f\u0930, \u0917\u094b\u0935\u0930\u094d\u0927\u0928",durationDisplay:"3:50",approxSeconds:230,audioUrl:"https://ia800301.us.archive.org/15/items/ShreeKrishnaBhajan/GovardhanAarti.mp3",significance:"\u0917\u093f\u0930\u093f\u0930\u093e\u091c \u092e\u0939\u093e\u0930\u093e\u091c \u091c\u0940 \u0915\u0940 \u092a\u0930\u093f\u0915\u094d\u0930\u092e\u093e \u0935 \u0926\u0930\u094d\u0936\u0928 \u0915\u0947 \u0938\u092e\u092f \u0915\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u092a\u093e\u0935\u0928 \u0906\u0930\u0924\u0940\u0964",lyrics:["\u0924\u0947\u0930\u0947 \u092e\u093e\u0925\u0947 \u092e\u0941\u0915\u0941\u091f \u0935\u093f\u0930\u093e\u091c \u0930\u0939\u094d\u092f\u094c, \u0924\u094b\u092a\u0947 \u092a\u093e\u0928 \u091a\u0922\u093c\u0947 \u0924\u094b\u092a\u0947 \u092b\u0942\u0932 \u091a\u0922\u093c\u0947,","\u0924\u094b\u092a\u0947 \u091a\u0922\u093c\u0947 \u0926\u0942\u0927 \u0915\u0940 \u0927\u093e\u0930, \u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092e\u0939\u093e\u0930\u093e\u091c, \u0924\u0947\u0930\u0947 \u092e\u093e\u0925\u0947 \u092e\u0941\u0915\u0941\u091f \u0935\u093f\u0930\u093e\u091c \u0930\u0939\u094d\u092f\u094c \u0965","\u0924\u0947\u0930\u0947 \u0915\u093e\u0928\u0928 \u0915\u0941\u0923\u094d\u0921\u0932 \u0938\u094b\u0939\u0948\u0902, \u0924\u0947\u0930\u0940 \u091b\u0935\u093f \u0932\u0916\u093f \u0924\u094d\u0930\u093f\u092d\u0941\u0935\u0928 \u092e\u094b\u0939\u0948\u0902,","\u0924\u0947\u0930\u0947 \u0928\u0948\u0928\u0928 \u0938\u0941\u0930\u092e\u093e \u091b\u093e\u091c \u0930\u0939\u094d\u092f\u094c, \u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092e\u0939\u093e\u0930\u093e\u091c \u0965","\u092e\u093e\u0928\u0938\u0940 \u0917\u0902\u0917\u093e \u092e\u0947\u0902 \u091c\u094b \u0928\u0939\u093e\u092f, \u092e\u0941\u0915\u094d\u0924\u093f \u0905\u092e\u0930 \u092a\u0926 \u0938\u094b \u091c\u0928 \u092a\u093e\u092f,","\u0930\u093e\u0927\u093e\u0915\u0941\u0923\u094d\u0921 \u092e\u0947\u0902 \u0905\u092e\u0943\u0924 \u0927\u093e\u0930, \u0917\u094b\u0935\u0930\u094d\u0927\u0928 \u092e\u0939\u093e\u0930\u093e\u091c \u0965"]},{id:"hare_krishna_mahamantra",titleHindi:"\u092a\u093e\u0935\u0928 \u092e\u0939\u093e\u092e\u0902\u0924\u094d\u0930 \u0938\u0902\u0915\u0940\u0930\u094d\u0924\u0928",titleEn:"Hare Krishna Mahamantra",deity:"\u0936\u094d\u0930\u0940 \u091a\u0948\u0924\u0928\u094d\u092f \u092e\u0939\u093e\u092a\u094d\u0930\u092d\u0941 \u0935 \u0930\u093e\u0927\u093e \u0915\u0943\u0937\u094d\u0923",temple:"\u0907\u0938\u094d\u0915\u0949\u0928 \u0915\u0943\u0937\u094d\u0923-\u092c\u0932\u0930\u093e\u092e \u092e\u0902\u0926\u093f\u0930, \u0935\u0943\u0902\u0